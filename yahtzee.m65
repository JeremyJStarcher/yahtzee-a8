; ================================================================
; Atari 800XL / Atari 8-bit
; 6502 Assembly Springboard Program
;
; Purpose:
;   Open the screen editor device "E:"
;   Print one line of text
;   Stop in an infinite loop
;
; Auto-run:
;   This source includes a RUNAD segment at $02E0/$02E1.
;   When loaded as an Atari DOS binary/XEX file, DOS will jump
;   to START after the file finishes loading.
;
; Boot-time auto-run:
;   Save/name the final binary as AUTORUN.SYS on a DOS disk.
;
; ================================================================



.MACRO PUSHALL
        php           ; Push status register
        STA SAVEA     ; Save the 'A' register while storing the others
        pha           ; Push A
        txa           ; X -> A
	pha           ; Push X value in A
	tya           ; Y -> A
	pha           ; PUSH Y value in A
        LDA SAVEA     ; And get our original 'A' back
.ENDM

.MACRO POPALL
        PLA           ; Get the pushed Y value
        TAY           ; Transfer to Y
        PLA           ; Get the pushed X value
        TAX           ; Transfer to X
        PLA           ; And then get A
        plp           ; Pull status register
.ENDM


; PRINTPTR <address> - prints the address in tihe pointer.
.MACRO PRINTPTR
        PUSHALL

        LDY #$01
        LDA %$1,Y
        JSR P_BYTEOUT
        DEY
        LDA %$1,Y
        JSR P_BYTEOUT

        POPALL
.ENDM

;; Yes, these macros are brutal and dirty... but they are meant for debugging, so that's OK.
;; I'm not worried about them being bloated as long as they are easy to use.
.MACRO PPRINTLN
   PPRINT %$1
   PPRINT EOL
.ENDM



.MACRO MAKE_OUTPUT_CONTROL
%$1_IOCB        .BYTE E_IOCB2
%$1_ROW         .BYTE 1
%$1_COL_L       .BYTE 1
%$1_COL_H       .BYTE 1
%$1_LEN_L       .BYTE 1
%$1_LEN_H       .BYTE 1
%$1_PTR_L       .BYTE 1
%$1_PTR_H       .BYTE 1
.ENDM


; ------------------------------------------------
; Main program load address
; ------------------------------------------------
        *=$00CB
STRPTR          .WORD 0
ENDPTR          .WORD 0
SAVEA           .BYTE 0  ; Save 'A' during PUSHALL
; A pointer to which set of pips we are rendering
PIP_PTR         .DS 2
PIP_MASK        .DS 1

; Free 0-page address (USED BY BASIC)
; $CB - $D1


.INCLUDE sysequ.m65
.INCLUDE iomac.lib
.INCLUDE scores/binary.asm

        *=$4000
.INCLUDE scores/ram.m65
PRNBUF          .DS 5
SCRBUF          .DS 5



; The current die being operated on.
CURRENT_DIE             .DS 1
CURRENT_PIP_ON_SCREEN   .DS 1
CURRENT_PIP_ON_DIE      .DS 1
CURRENT_PIP_PATTERN     .BYTE 1


        MAKE_OUTPUT_CONTROL SCR

        *=$2400

.INCLUDE hardware/a8/atari_keys.m65
.INCLUDE hardware/a8/io.m65

.INCLUDE scores/strings.m65
.INCLUDE gameloop.m65


NUMBER_OF_PIPS = 7

; ================================================================
; PROGRAM ENTRY POINT
; ================================================================

START
        JSR INIT_PROGRAM

        JSR CLRRAM
        JSR CLRDICE

        ; Set left margin
        LDA #0
        STA LMARGN

        LDA #1
        STA CRSINH ; HIDE CURSOR

        ; Print the message.
        LDY #TITLE_MAIN
        JSR DISPLAY_MESSAGE

        LDY #TITLE_MAIN
NEXT_LABEL
        JSR DISPLAY_MESSAGE
        DEY
        BPL NEXT_LABEL        ; Branches if the value is between 0-127

        LDY #TITLE_DIE4
NEXT_LABELD
        JSR DISPLAY_MESSAGE
        DEY
        TYA
        CMP #TITLE_DIE0
        BCS NEXT_LABELD        ; CS (Not less than)



        JSR SHOW_PIPS

        JSR GAMELOOP

        ; Optional: close IOCB #2.
        ; For a tiny demo this is not strictly required,
        ; but it is a good habit for larger programs.
        JMP FINISH_PROGRAM

; Y = The index of the message to print
DISPLAY_MESSAGE
         PUSHALL        ; Save all registers

        ; Address of the text buffer to print.
        LDA TITLE_TXT_LSB_TABLE,Y
        STA SCR_PTR_L
        LDA TITLE_TXT_MSB_TABLE,Y
        STA SCR_PTR_H

        ; Length of the text buffer.
        LDA TITLE_LEN_LSB_TABLE,Y
        STA SCR_LEN_L
        LDA TITLE_LEN_MSB_TABLE,Y
        STA SCR_LEN_H

        ; Set cursor position
        LDA TITLE_ROW_TABLE,Y
        STA SCR_ROW

        LDA TITLE_COL_LSB_TABLE, Y
        STA SCR_COL_L
        LDA TITLE_COL_MSB_TABLE, Y
        STA SCR_COL_H

        JSR HW_DISPLAY

        POPALL         ; Restore all registers
        RTS

CLRDICE
        PHA
        LDA # <DICE_VALUES
        STA STRPTR
        LDA # >DICE_VALUES
        STA STRPTR + 1

        LDA # <DICE_VALUES_END
        STA ENDPTR
        LDA # >DICE_VALUES_END
        STA ENDPTR + 1
        PLA

        LDA #$00        ; The value set RAM to
        JMP MEMFILL     ; Clear the ram

CLRRAM
        PHA
        LDA # <START_REGION_RAM
        STA STRPTR
        LDA # >START_REGION_RAM
        STA STRPTR + 1

        LDA # <END_REGION_RAM
        STA ENDPTR
        LDA # >END_REGION_RAM
        STA ENDPTR + 1
        PLA

        LDA #$00        ; The value set RAM to

MEMFILL:
        TAX             ; Save fill byte in X (A is clobbered by comparisons)
        LDY #$00        ; Y stays 0 for (STRPTR),Y addressing

MEMFILL_LOOP:

        ; ---------- Check for end (exclusive) ----------
        LDA STRPTR
        CMP ENDPTR
        BNE MEMFILL_WRITE   ; Low bytes differ → not at end yet

        LDA STRPTR+1
        CMP ENDPTR+1
        BEQ MEMFILL_DONE    ; High bytes also equal → STRPTR == ENDPTR, stop

MEMFILL_WRITE:
        ; ---------- Write the fill byte ----------
        ; -- Debugging JSR CLRMSG
        TXA             ; Retrieve fill byte from X
        STA (STRPTR),Y

        ; ---------- Increment 16‑bit pointer ----------
        INC STRPTR
        BNE MEMFILL_LOOP    ; No low‑byte rollover → loop
        INC STRPTR+1     ; Rollover from $FF to $00 → bump high byte
        JMP MEMFILL_LOOP

MEMFILL_DONE:
        RTS

;        "┌───┐",
;        "|0 1|",
;        "|234|",
;        "|5 6|",
;        "└───┘",

DIE_PATTERN_0 = B00000000
DIE_PATTERN_1 = B00010000
DIE_PATTERN_2 = B01000100
DIE_PATTERN_3 = B01010100
DIE_PATTERN_4 = B11000110
DIE_PATTERN_5 = B11010110
DIE_PATTERN_6 = B11101110

PIP_PATTERNS
        .BYTE DIE_PATTERN_0
        .BYTE DIE_PATTERN_1
        .BYTE DIE_PATTERN_2
        .BYTE DIE_PATTERN_3
        .BYTE DIE_PATTERN_4
        .BYTE DIE_PATTERN_5
        .BYTE DIE_PATTERN_6

SHOW_PIPS
        JSR GetRandom
        STA DICE_0_VALUE
        JSR GetRandom
        STA DICE_1_VALUE
        JSR GetRandom
        STA DICE_2_VALUE
        JSR GetRandom
        STA DICE_3_VALUE
        JSR GetRandom
        STA DICE_4_VALUE


;; Set up work
        LDY #$00
        STY CURRENT_DIE
        LDA PIP_PATTERNS,Y
        STA CURRENT_PIP_PATTERN

        LDA PIP_PTR_LSB,Y
        STA PIP_PTR
        LDA PIP_PTR_MSB,Y
        STA PIP_PTR +1

        LDA #$00
        STA CURRENT_PIP_ON_SCREEN

        LDX #5
SPIPL2
        LDY #NUMBER_OF_PIPS
SPIPL
        STY CURRENT_PIP_ON_DIE
        JSR SHOWPIP
        DEY
        BNE SPIPL
        INC CURRENT_DIE
        DEX
        BNE SPIPL2
        RTS


SHFTPIP
        .BYTE B00000001
        .BYTE B00000010
        .BYTE B00000100
        .BYTE B00001000
        .BYTE B00010000
        .BYTE B00100000
        .BYTE B01000000
        .BYTE B10000000

SHOWPIP
        PUSHALL        ; Save all registers

        PREP_DISPLAY

        LDA #<SCRBUF
        STA SCR_PTR_L
        LDA #>SCRBUF
        STA SCR_PTR_H

        LDA #$01
        STA SCR_LEN_L
        LDA #$00
        STA SCR_LEN_H

        LDY CURRENT_PIP_ON_SCREEN

        LDA (PIP_PTR),Y
        STA SCR_ROW

        ; Next byte
        INY
        LDA (PIP_PTR),Y
        STA SCR_COL_L
        INY
        LDA (PIP_PTR),Y
        STA SCR_COL_H
        INY
        STY CURRENT_PIP_ON_SCREEN

        ; Get the pattern for the current dice value
        LDX CURRENT_DIE
        LDA DICE_VALUES,X
        TAX
        LDA PIP_PATTERNS,X
        STA PIP_MASK

        LDY CURRENT_PIP_ON_DIE
        LDA SHFTPIP,Y
        BIT PIP_MASK
        BNE PIP_SHOW_FILLED

        LDY #32
        JMP PIPSHOW_DISPLAY

PIP_SHOW_FILLED
        LDY #'*'

PIPSHOW_DISPLAY
        STY SCRBUF+0
        JSR HW_DISPLAY

        POPALL         ; Restore all registers
        RTS

;; These functions were written as debugging tools, not regular
;; library calls, hence they are somewhat paranoid about preserving
;; registers.  This lets us just drop them anywhere and not have worry
;; about program logic changing.


P_BYTEOUT
        PHA        ; Save the byte to retrieve at the end
        PHA        ; save the byte
        LSR A      ; Shift the high nibble to the low nibble
        LSR A      ;
        LSR A      ;
        LSR A      ;
        JSR P_NIBBLE_OUT ;
        PLA        ; Restore the saved byte
        AND #$0F   ; Now get the lower nibble
        JSR P_NIBBLE_OUT ; And print
        PLA        ; retrieve the byte
        RTS

; ****************************************************************
; This is the 8-bit random number generator subroutine that uses
; the Galois linear feedback shift register (LFSR) approach.
; This generates and returns a number between 0-255.
; Have two of these to avoid dependencies between powerups and
; mutations.
; ****************************************************************

RandomPU        .BYTE 95
RandomMut       .BYTE 74
RandomFlip      .BYTE 0

LL
        PPRINT "ROLLED A "
        JSR P_BYTEOUT
        PPRINTLN " "
        RTS

GetRandom
        INC RandomFlip
        LDA RandomFlip
        LSR
        BCS GetRandom1

        JSR GetRandomPU
        JMP GetRandom2

GetRandom1
        JSR GetRandomMut
GetRandom2
        AND #B00000111
        CMP #$06        ; The number of faces
        BCS GetRandom

        CMP #$00
        BEQ GetRandom
        JSR LL
        RTS

GetRandomPU             ; this is for powerups
lda RandomPU            ; load the accumulator with a seed
    	lsr             ; logical shift right
    	bcc SkipEor1    ; branch on carry clear
    	eor #$D4        ; exclusive OR (i.e. XOR) function

SkipEor1

   	sta RandomPU      ; store the random number in variable
   	rts               ; return from subroutine

GetRandomMut              ; this is for mutation flag

   	lda RandomMut   ; load the accumulator with a seed
    	lsr             ; logical shift right
    	bcc SkipEor2      ; branch on carry clear
    	eor #$A9          ; exclusive OR (i.e. XOR) function
                          ; $A9 generates inverse sequence

SkipEor2

   	sta RandomMut     ; store the random number in variable
   	rts               ; return from subroutine

; ================================================================
; AUTO-RUN SEGMENT
; ================================================================
;
; Atari DOS binary loaders use locations $02E0/$02E1 as RUNAD.
;
; RUNAD contains the address to execute after the whole binary
; file has finished loading.
;
; By placing START here, the DOS binary loader will run START
; automatically after load.
;
; Many Atari-aware assemblers will output this as a second
; binary segment in the same .OBJ/.XEX file.
;
; If your assembler only creates a raw flat binary, see notes below.
; ================================================================

        *=$02E0

        .WORD START
