00.000770r 2               ; ============================================================================
00.000770r 2               ; Branch Macro Test Suite
00.000770r 2               ; ============================================================================
00.000770r 2               ;
00.000770r 2               ; Requires:
00.000770r 2               ;   DISPLAY_PSTRING
00.000770r 2               ;   DISPLAY_NEXT_LINE
00.000770r 2               ;   DISPLAY_PTR
00.000770r 2               ;   CURRENT_COLOR
00.000770r 2               ;   DEFAULT_COLOR
00.000770r 2               ;   pstring
00.000770r 2               ;
00.000770r 2               ; expected_taken:
00.000770r 2               ;   0 = branch should not be taken
00.000770r 2               ;   1 = branch should be taken
00.000770r 2               ; ============================================================================
00.000770r 2               
00.000770r 2               TEST_FAIL_COLOR = $A3
00.000770r 2               
00.000770r 2               BRANCH_NOT_TAKEN = 0
00.000770r 2               BRANCH_TAKEN     = 1
00.000770r 2               
00.000770r 2               
00.000770r 2               ; ----------------------------------------------------------------------------
00.000770r 2               ; Test result strings
00.000770r 2               ; ----------------------------------------------------------------------------
00.000770r 2               
00.000770r 2               test_branch_taken:
00.000770r 2                   pstring "BRANCH TAKEN"
00.000770r 0  0C 42 52 41  >  .BYTE .STRLEN(str), str
00.000774r 0  4E 43 48 20  
00.000778r 0  54 41 4B 45  
00.00077Cr 0  4E           
00.00077Dr 2               
00.00077Dr 2               test_branch_not_taken:
00.00077Dr 2                   pstring "BRANCH NOT TAKEN"
00.00077Dr 0  10 42 52 41  >  .BYTE .STRLEN(str), str
00.000781r 0  4E 43 48 20  
00.000785r 0  4E 4F 54 20  
00.000789r 0  54 41 4B 45  
00.00078Er 2               
00.00078Er 2               
00.00078Er 2               ; ----------------------------------------------------------------------------
00.00078Er 2               ; Test state
00.00078Er 2               ; ----------------------------------------------------------------------------
00.00078Er 2               
00.00078Er 2               .segment "ZEROPAGE"
04.000010r 2               
04.000010r 2               ; Keep your existing fail_flag allocation if it already exists.
04.000010r 2               ; fail_flag:
04.000010r 2               ;     .res 1
04.000010r 2               
04.000010r 2               ; Used by the long-jump tests.
04.000010r 2               branch_test_actual:
04.000010r 2  xx               .res 1
04.000011r 2               
04.000011r 2               
04.000011r 2               .segment "CODE"
00.00078Er 2               
00.00078Er 2               
00.00078Er 2               ; ============================================================================
00.00078Er 2               ; Mark the current test as failed
00.00078Er 2               ; ============================================================================
00.00078Er 2               
00.00078Er 2               .macro mark_branch_test_failed
00.00078Er 2                   lda #TEST_FAIL_COLOR
00.00078Er 2                   sta CURRENT_COLOR
00.00078Er 2               
00.00078Er 2                   lda #$01
00.00078Er 2                   sta fail_flag
00.00078Er 2               .endmacro
00.00078Er 2               
00.00078Er 2               
00.00078Er 2               ; ============================================================================
00.00078Er 2               ; Test a branch macro that expects flags to have been set by CMP
00.00078Er 2               ;
00.00078Er 2               ; Example:
00.00078Er 2               ;   create_branch_test "BLT 0,1", blt, 0, 1, BRANCH_TAKEN
00.00078Er 2               ; ============================================================================
00.00078Er 2               
00.00078Er 2               .macro create_branch_test test_name, macroopcode, val1, val2, expected_taken
00.00078Er 2                   .local test_string
00.00078Er 2                   .local test_start
00.00078Er 2                   .local did_branch
00.00078Er 2                   .local not_taken_ok
00.00078Er 2                   .local taken_ok
00.00078Er 2                   .local test_done
00.00078Er 2                   .local exit2
00.00078Er 2               
00.00078Er 2                   ; Skip the inline Pascal string.
00.00078Er 2                   jmp test_start
00.00078Er 2               
00.00078Er 2               test_string:
00.00078Er 2                   pstring test_name
00.00078Er 2               
00.00078Er 2               test_start:
00.00078Er 2                   lda #DEFAULT_COLOR
00.00078Er 2                   sta CURRENT_COLOR
00.00078Er 2               
00.00078Er 2                   load16 DISPLAY_PTR, test_string
00.00078Er 2                   jsr DISPLAY_PSTRING
00.00078Er 2               
00.00078Er 2                   ; Establish flags through an unsigned compare.
00.00078Er 2                   lda #val1
00.00078Er 2                   cmp #val2
00.00078Er 2               
00.00078Er 2                   macroopcode did_branch
00.00078Er 2               
00.00078Er 2                   ; ------------------------------------------------------------------------
00.00078Er 2                   ; Actual result: branch not taken
00.00078Er 2                   ; ------------------------------------------------------------------------
00.00078Er 2               
00.00078Er 2                   lda #expected_taken
00.00078Er 2                   beq not_taken_ok
00.00078Er 2               
00.00078Er 2                   mark_branch_test_failed
00.00078Er 2               
00.00078Er 2               not_taken_ok:
00.00078Er 2                   load16 DISPLAY_PTR, test_branch_not_taken
00.00078Er 2                   jsr DISPLAY_PSTRING
00.00078Er 2                   jsr DISPLAY_NEXT_LINE
00.00078Er 2                   jmp test_done
00.00078Er 2               
00.00078Er 2               did_branch:
00.00078Er 2                   ; ------------------------------------------------------------------------
00.00078Er 2                   ; Actual result: branch taken
00.00078Er 2                   ; ------------------------------------------------------------------------
00.00078Er 2               
00.00078Er 2                   lda #expected_taken
00.00078Er 2                   bne taken_ok
00.00078Er 2               
00.00078Er 2                   mark_branch_test_failed
00.00078Er 2               
00.00078Er 2               taken_ok:
00.00078Er 2                   load16 DISPLAY_PTR, test_branch_taken
00.00078Er 2                   jsr DISPLAY_PSTRING
00.00078Er 2                   jsr DISPLAY_NEXT_LINE
00.00078Er 2               
00.00078Er 2               test_done:
00.00078Er 2                   lda fail_flag
00.00078Er 2                   beq exit2
00.00078Er 2                   jmp freeze_it
00.00078Er 2               exit2:
00.00078Er 2               .endmacro
00.00078Er 2               
00.00078Er 2               
00.00078Er 2               ; ============================================================================
00.00078Er 2               ; Test one of the combined "if_a_*" macros
00.00078Er 2               ;
00.00078Er 2               ; The tested macro performs its own CMP.
00.00078Er 2               ;
00.00078Er 2               ; Example:
00.00078Er 2               ;   create_a_compare_test "A LT 0,1", if_a_lt, 0, 1, BRANCH_TAKEN
00.00078Er 2               ; ============================================================================
00.00078Er 2               
00.00078Er 2               .macro create_a_compare_test test_name, macroopcode, a_value, compare_value, expected_taken
00.00078Er 2                   .local test_string
00.00078Er 2                   .local test_start
00.00078Er 2                   .local did_branch
00.00078Er 2                   .local not_taken_ok
00.00078Er 2                   .local taken_ok
00.00078Er 2                   .local test_done
00.00078Er 2                   .local exit2
00.00078Er 2               
00.00078Er 2                   jmp test_start
00.00078Er 2               
00.00078Er 2               test_string:
00.00078Er 2                   pstring test_name
00.00078Er 2               
00.00078Er 2               test_start:
00.00078Er 2                   lda #DEFAULT_COLOR
00.00078Er 2                   sta CURRENT_COLOR
00.00078Er 2               
00.00078Er 2                   load16 DISPLAY_PTR, test_string
00.00078Er 2                   jsr DISPLAY_PSTRING
00.00078Er 2               
00.00078Er 2                   lda #a_value
00.00078Er 2                   macroopcode compare_value, did_branch
00.00078Er 2               
00.00078Er 2                   ; ------------------------------------------------------------------------
00.00078Er 2                   ; Actual result: branch not taken
00.00078Er 2                   ; ------------------------------------------------------------------------
00.00078Er 2               
00.00078Er 2                   lda #expected_taken
00.00078Er 2                   beq not_taken_ok
00.00078Er 2               
00.00078Er 2                   mark_branch_test_failed
00.00078Er 2               
00.00078Er 2               not_taken_ok:
00.00078Er 2                   load16 DISPLAY_PTR, test_branch_not_taken
00.00078Er 2                   jsr DISPLAY_PSTRING
00.00078Er 2                   jsr DISPLAY_NEXT_LINE
00.00078Er 2                   jmp test_done
00.00078Er 2               
00.00078Er 2               did_branch:
00.00078Er 2                   ; ------------------------------------------------------------------------
00.00078Er 2                   ; Actual result: branch taken
00.00078Er 2                   ; ------------------------------------------------------------------------
00.00078Er 2               
00.00078Er 2                   lda #expected_taken
00.00078Er 2                   bne taken_ok
00.00078Er 2               
00.00078Er 2                   mark_branch_test_failed
00.00078Er 2               
00.00078Er 2               taken_ok:
00.00078Er 2                   load16 DISPLAY_PTR, test_branch_taken
00.00078Er 2                   jsr DISPLAY_PSTRING
00.00078Er 2                   jsr DISPLAY_NEXT_LINE
00.00078Er 2               
00.00078Er 2               test_done:
00.00078Er 2                   lda fail_flag
00.00078Er 2                   beq exit2
00.00078Er 2                   jmp freeze_it
00.00078Er 2               exit2:
00.00078Er 2               .endmacro
00.00078Er 2               
00.00078Er 2               
00.00078Er 2               ; ============================================================================
00.00078Er 2               ; Test a signed branch macro
00.00078Er 2               ;
00.00078Er 2               ; IMPORTANT:
00.00078Er 2               ;   CMP does not modify V, so signed comparisons cannot reliably use CMP.
00.00078Er 2               ;   SEC/SBC is used here to establish N and V for:
00.00078Er 2               ;
00.00078Er 2               ;       signed_lhs - signed_rhs
00.00078Er 2               ;
00.00078Er 2               ; Example:
00.00078Er 2               ;   create_signed_branch_test "SBLT -1,0", sblt, $FF, $00, BRANCH_TAKEN
00.00078Er 2               ; ============================================================================
00.00078Er 2               
00.00078Er 2               .macro create_signed_branch_test test_name, macroopcode, signed_lhs, signed_rhs, expected_taken
00.00078Er 2                   .local test_string
00.00078Er 2                   .local test_start
00.00078Er 2                   .local did_branch
00.00078Er 2                   .local not_taken_ok
00.00078Er 2                   .local taken_ok
00.00078Er 2                   .local test_done
00.00078Er 2                   .local exit2
00.00078Er 2               
00.00078Er 2                   jmp test_start
00.00078Er 2               
00.00078Er 2               test_string:
00.00078Er 2                   pstring test_name
00.00078Er 2               
00.00078Er 2               test_start:
00.00078Er 2                   lda #DEFAULT_COLOR
00.00078Er 2                   sta CURRENT_COLOR
00.00078Er 2               
00.00078Er 2                   load16 DISPLAY_PTR, test_string
00.00078Er 2                   jsr DISPLAY_PSTRING
00.00078Er 2               
00.00078Er 2                   ; Ensure binary arithmetic.
00.00078Er 2                   cld
00.00078Er 2               
00.00078Er 2                   ; Establish N and V using a real subtraction.
00.00078Er 2                   sec
00.00078Er 2                   lda #signed_lhs
00.00078Er 2                   sbc #signed_rhs
00.00078Er 2               
00.00078Er 2                   macroopcode did_branch
00.00078Er 2               
00.00078Er 2                   ; ------------------------------------------------------------------------
00.00078Er 2                   ; Actual result: branch not taken
00.00078Er 2                   ; ------------------------------------------------------------------------
00.00078Er 2               
00.00078Er 2                   lda #expected_taken
00.00078Er 2                   beq not_taken_ok
00.00078Er 2               
00.00078Er 2                   mark_branch_test_failed
00.00078Er 2               
00.00078Er 2               not_taken_ok:
00.00078Er 2                   load16 DISPLAY_PTR, test_branch_not_taken
00.00078Er 2                   jsr DISPLAY_PSTRING
00.00078Er 2                   jsr DISPLAY_NEXT_LINE
00.00078Er 2                   jmp test_done
00.00078Er 2               
00.00078Er 2               did_branch:
00.00078Er 2                   ; ------------------------------------------------------------------------
00.00078Er 2                   ; Actual result: branch taken
00.00078Er 2                   ; ------------------------------------------------------------------------
00.00078Er 2               
00.00078Er 2                   lda #expected_taken
00.00078Er 2                   bne taken_ok
00.00078Er 2               
00.00078Er 2                   mark_branch_test_failed
00.00078Er 2               
00.00078Er 2               taken_ok:
00.00078Er 2                   load16 DISPLAY_PTR, test_branch_taken
00.00078Er 2                   jsr DISPLAY_PSTRING
00.00078Er 2                   jsr DISPLAY_NEXT_LINE
00.00078Er 2               
00.00078Er 2               test_done:
00.00078Er 2                   lda fail_flag
00.00078Er 2                   beq exit2
00.00078Er 2                   jmp freeze_it
00.00078Er 2               exit2:
00.00078Er 2               .endmacro
00.00078Er 2               
00.00078Er 2               
00.00078Er 2               ; ============================================================================
00.00078Er 2               ; Test a smart long-jump macro
00.00078Er 2               ;
00.00078Er 2               ; The destination is deliberately placed more than 127 bytes backward so the
00.00078Er 2               ; check_branch_distance macro recognizes this as a legitimate long jump.
00.00078Er 2               ;
00.00078Er 2               ; Example:
00.00078Er 2               ;   create_long_branch_test "JEQ 1,1", jeq, 1, 1, BRANCH_TAKEN
00.00078Er 2               ; ============================================================================
00.00078Er 2               
00.00078Er 2               .macro create_long_branch_test test_name, macroopcode, val1, val2, expected_taken
00.00078Er 2                   .local test_string
00.00078Er 2                   .local test_start
00.00078Er 2                   .local far_branch_target
00.00078Er 2                   .local evaluate_result
00.00078Er 2                   .local actual_taken
00.00078Er 2                   .local not_taken_ok
00.00078Er 2                   .local taken_ok
00.00078Er 2                   .local test_done
00.00078Er 2                   .local exit2
00.00078Er 2               
00.00078Er 2                   ; Normal execution skips the backward branch target and padding.
00.00078Er 2                   jmp test_start
00.00078Er 2               
00.00078Er 2               far_branch_target:
00.00078Er 2                   lda #$01
00.00078Er 2                   sta branch_test_actual
00.00078Er 2                   jmp evaluate_result
00.00078Er 2               
00.00078Er 2                   ; Force far_branch_target outside ordinary relative branch range.
00.00078Er 2                   .repeat 132
00.00078Er 2                       nop
00.00078Er 2                   .endrepeat
00.00078Er 2               
00.00078Er 2               test_string:
00.00078Er 2                   pstring test_name
00.00078Er 2               
00.00078Er 2               test_start:
00.00078Er 2                   lda #DEFAULT_COLOR
00.00078Er 2                   sta CURRENT_COLOR
00.00078Er 2               
00.00078Er 2                   load16 DISPLAY_PTR, test_string
00.00078Er 2                   jsr DISPLAY_PSTRING
00.00078Er 2               
00.00078Er 2                   lda #$00
00.00078Er 2                   sta branch_test_actual
00.00078Er 2               
00.00078Er 2                   lda #val1
00.00078Er 2                   cmp #val2
00.00078Er 2               
00.00078Er 2                   macroopcode far_branch_target
00.00078Er 2               
00.00078Er 2               evaluate_result:
00.00078Er 2                   lda branch_test_actual
00.00078Er 2                   bne actual_taken
00.00078Er 2               
00.00078Er 2                   ; ------------------------------------------------------------------------
00.00078Er 2                   ; Actual result: branch not taken
00.00078Er 2                   ; ------------------------------------------------------------------------
00.00078Er 2               
00.00078Er 2                   lda #expected_taken
00.00078Er 2                   beq not_taken_ok
00.00078Er 2               
00.00078Er 2                   mark_branch_test_failed
00.00078Er 2               
00.00078Er 2               not_taken_ok:
00.00078Er 2                   load16 DISPLAY_PTR, test_branch_not_taken
00.00078Er 2                   jsr DISPLAY_PSTRING
00.00078Er 2                   jsr DISPLAY_NEXT_LINE
00.00078Er 2                   jmp test_done
00.00078Er 2               
00.00078Er 2               actual_taken:
00.00078Er 2                   ; ------------------------------------------------------------------------
00.00078Er 2                   ; Actual result: branch taken
00.00078Er 2                   ; ------------------------------------------------------------------------
00.00078Er 2               
00.00078Er 2                   lda #expected_taken
00.00078Er 2                   bne taken_ok
00.00078Er 2               
00.00078Er 2                   mark_branch_test_failed
00.00078Er 2               
00.00078Er 2               taken_ok:
00.00078Er 2                   load16 DISPLAY_PTR, test_branch_taken
00.00078Er 2                   jsr DISPLAY_PSTRING
00.00078Er 2                   jsr DISPLAY_NEXT_LINE
00.00078Er 2               
00.00078Er 2               test_done:
00.00078Er 2                   lda fail_flag
00.00078Er 2                   beq exit2
00.00078Er 2                   jmp freeze_it
00.00078Er 2               exit2:
00.00078Er 2               .endmacro
00.00078Er 2               
00.00078Er 2               
00.00078Er 2               ; ============================================================================
00.00078Er 2               ; Complete branch macro test procedure
00.00078Er 2               ; ============================================================================
00.00078Er 2               
00.00078Er 2               .proc test_branch_macro
00.00078Er 2  20 rr rr         jsr reset_screen
00.000791r 2               
00.000791r 2  A9 00            lda #$00
00.000793r 2  8D rr rr         sta fail_flag
00.000796r 2               
00.000796r 2                   ; ========================================================================
00.000796r 2                   ; 1. UNSIGNED CONDITIONAL BRANCHES
00.000796r 2                   ; ========================================================================
00.000796r 2               
00.000796r 2                   ; BEQ alias
00.000796r 2                   create_branch_test "BEQ 0 == 0 ", beq_alias, $00, $00, BRANCH_TAKEN
00.000796r 0  4C rr rr     >  jmp test_start
00.000799r 0               >  pstring test_name
00.000799r 0  0B 42 45 51  >>  .BYTE .STRLEN(str), str
00.00079Dr 0  20 30 20 3D  
00.0007A1r 0  3D 20 30 20  
00.0007A5r 0  A9 6F        >  lda #DEFAULT_COLOR
00.0007A7r 0  85 rr        >  sta CURRENT_COLOR
00.0007A9r 0               >  load16 DISPLAY_PTR, test_string
00.0007A9r 0  A9 rr        >>  LDA #<IMM
00.0007ABr 0  85 rr        >>  STA PTR
00.0007ADr 0  A9 rr        >>  LDA #>IMM
00.0007AFr 0  85 rr        >>  STA PTR + 1
00.0007B1r 0  20 rr rr     >  jsr DISPLAY_PSTRING
00.0007B4r 0  A9 00        >  lda #val1
00.0007B6r 0  C9 00        >  cmp #val2
00.0007B8r 0               >  macroopcode did_branch
00.0007B8r 0  F0 1E        >>  BEQ target
00.0007BAr 0  A9 01        >  lda #expected_taken
00.0007BCr 0  F0 09        >  beq not_taken_ok
00.0007BEr 0               >  mark_branch_test_failed
00.0007BEr 0  A9 A3        >>  lda #TEST_FAIL_COLOR
00.0007C0r 0  85 rr        >>  sta CURRENT_COLOR
00.0007C2r 0  A9 01        >>  lda #1
00.0007C4r 0  8D rr rr     >>  sta fail_flag
00.0007C7r 0               >  load16 DISPLAY_PTR, test_branch_not_taken
00.0007C7r 0  A9 rr        >>  LDA #<IMM
00.0007C9r 0  85 rr        >>  STA PTR
00.0007CBr 0  A9 rr        >>  LDA #>IMM
00.0007CDr 0  85 rr        >>  STA PTR + 1
00.0007CFr 0  20 rr rr     >  jsr DISPLAY_PSTRING
00.0007D2r 0  20 rr rr     >  jsr DISPLAY_NEXT_LINE
00.0007D5r 0  4C rr rr     >  jmp test_done
00.0007D8r 0  A9 01        >  lda #expected_taken
00.0007DAr 0  D0 09        >  bne taken_ok
00.0007DCr 0               >  mark_branch_test_failed
00.0007DCr 0  A9 A3        >>  lda #TEST_FAIL_COLOR
00.0007DEr 0  85 rr        >>  sta CURRENT_COLOR
00.0007E0r 0  A9 01        >>  lda #1
00.0007E2r 0  8D rr rr     >>  sta fail_flag
00.0007E5r 0               >  load16 DISPLAY_PTR, test_branch_taken
00.0007E5r 0  A9 rr        >>  LDA #<IMM
00.0007E7r 0  85 rr        >>  STA PTR
