00.0001FAr 1               ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
00.0001FAr 1               ; Input:
00.0001FAr 1               ;   TMP_PTR   = first address to fill
00.0001FAr 1               ;   DISPLAY_PTR = exclusive end address
00.0001FAr 1               ;   A         = fill byte
00.0001FAr 1               ;
00.0001FAr 1               ; Requires:
00.0001FAr 1               ;   TMP_PTR <= DISPLAY_PTR
00.0001FAr 1               ;
00.0001FAr 1               ; Clobbers:
00.0001FAr 1               ;   A, X, Y, TMP_PTR
00.0001FAr 1               
00.0001FAr 1               .proc MEMFILL_FAST
00.0001FAr 1  AA               TAX                                 ; X = fill byte
00.0001FBr 1               
00.0001FBr 1                   ; --------------------------------------------------------------------
00.0001FBr 1                   ; Phase 1: Clear partial start page up to the $xx00 boundary
00.0001FBr 1                   ; --------------------------------------------------------------------
00.0001FBr 1  A0 00            LDY #$00
00.0001FDr 1               @ALIGN_LOOP:
00.0001FDr 1  A5 rr            LDA TMP_PTR                         ; Check if low byte is $00 (page aligned)
00.0001FFr 1  F0 13            BEQ @FILL_PAGES                     ; If TMP_PTR points to $xx00, head alignment is done!
00.000201r 1               
00.000201r 1                   ; Check if TMP_PTR has already hit DISPLAY_PTR before we finish aligning
00.000201r 1  C5 rr            CMP DISPLAY_PTR
00.000203r 1  D0 06            BNE @ALIGN_WRITE
00.000205r 1  A5 rr            LDA TMP_PTR+1
00.000207r 1  C5 rr            CMP DISPLAY_PTR+1
00.000209r 1  F0 25            BEQ @DONE                           ; Reached DISPLAY_PTR during alignment phase!
00.00020Br 1               
00.00020Br 1               @ALIGN_WRITE:
00.00020Br 1  8A               TXA
00.00020Cr 1  91 rr            STA (TMP_PTR), Y
00.00020Er 1  E6 rr            INC TMP_PTR
00.000210r 1  D0 EB            BNE @ALIGN_LOOP
00.000212r 1  E6 rr            INC TMP_PTR+1
00.000214r 1               
00.000214r 1                   ; --------------------------------------------------------------------
00.000214r 1                   ; Phase 2: Clear whole 256-byte pages
00.000214r 1                   ; --------------------------------------------------------------------
00.000214r 1               @FILL_PAGES:
00.000214r 1  A5 rr            LDA TMP_PTR+1
00.000216r 1  C5 rr            CMP DISPLAY_PTR+1
00.000218r 1  F0 0B            BEQ @FILL_REMAINDER                 ; High bytes match -> only partial tail page left!
00.00021Ar 1               
00.00021Ar 1  8A               TXA
00.00021Br 1               @PAGE_LOOP:
00.00021Br 1  91 rr            STA (TMP_PTR), Y                    ; Write byte at (TMP_PTR) + Y
00.00021Dr 1  C8               INY                                 ; 8-bit increment (very fast!)
00.00021Er 1  D0 FB            BNE @PAGE_LOOP                      ; Loops 256 times until Y wraps back to $00
00.000220r 1               
00.000220r 1  E6 rr            INC TMP_PTR+1                       ; Advance to next 256-byte page
00.000222r 1  4C rr rr         JMP @FILL_PAGES
00.000225r 1               
00.000225r 1                   ; --------------------------------------------------------------------
00.000225r 1                   ; Phase 3: Clear the remaining partial page
00.000225r 1                   ; --------------------------------------------------------------------
00.000225r 1               @FILL_REMAINDER:
00.000225r 1               ; Y is currently $00. We fill from $00 up to DISPLAY_PTR low byte.
00.000225r 1  8A               TXA
00.000226r 1               @TAIL_LOOP:
00.000226r 1  C4 rr            CPY DISPLAY_PTR                     ; Reached remaining byte count?
00.000228r 1  F0 06            BEQ @DONE
00.00022Ar 1  91 rr            STA (TMP_PTR), Y                    ; Write remaining bytes
00.00022Cr 1  C8               INY
00.00022Dr 1  4C rr rr         JMP @TAIL_LOOP
00.000230r 1               
00.000230r 1               @DONE:
00.000230r 1  60               RTS
00.000231r 1               .endproc
