ca65 V2.19 - WASI 2.19
Main file   : src/bios.asm
Current file: src/bios.asm

00.000000r 1               ; Simple 6502 BIOS/Kernel Assembly Source
00.000000r 1               ; Target: ca65 assembler from cc65 toolchain
00.000000r 1               
00.000000r 1                   .include "branches.inc"
00.000000r 2               ; ============================================================================
00.000000r 2               ; ca65 Synthetic Branching and Relational Macro Suite
00.000000r 2               ; ============================================================================
00.000000r 2               ;
00.000000r 2               ; This file provides:
00.000000r 2               ;
00.000000r 2               ;   1. Short unsigned branch aliases
00.000000r 2               ;   2. Short signed relational branches
00.000000r 2               ;   3. Combined CMP-immediate-and-branch helpers
00.000000r 2               ;   4. Long conditional jumps implemented with an inverse branch plus JMP
00.000000r 2               ;
00.000000r 2               ;
00.000000r 2               ; SHORT-BRANCH RANGE
00.000000r 2               ; ------------------
00.000000r 2               ; Macros in sections 1 through 3 ultimately emit ordinary 6502 relative branch
00.000000r 2               ; instructions. Their target must therefore be within the normal signed 8-bit
00.000000r 2               ; branch displacement:
00.000000r 2               ;
00.000000r 2               ;       -128 to +127 bytes from the instruction following the branch
00.000000r 2               ;
00.000000r 2               ; Use the long-jump macros in section 4 when the destination may be farther
00.000000r 2               ; away.
00.000000r 2               ;
00.000000r 2               ;
00.000000r 2               ; UNSIGNED COMPARISONS
00.000000r 2               ; --------------------
00.000000r 2               ; Unsigned comparisons may follow CMP, CPX, or CPY.
00.000000r 2               ;
00.000000r 2               ; After:
00.000000r 2               ;
00.000000r 2               ;       CMP operand
00.000000r 2               ;
00.000000r 2               ; the relevant unsigned relationships are:
00.000000r 2               ;
00.000000r 2               ;       Z = 1       equal
00.000000r 2               ;       Z = 0       not equal
00.000000r 2               ;       C = 0       less than
00.000000r 2               ;       C = 1       greater than or equal
00.000000r 2               ;       C = 1,Z = 0 greater than
00.000000r 2               ;       C = 0,Z = * less than
00.000000r 2               ;       Z = 1       equal
00.000000r 2               ;
00.000000r 2               ; Values are interpreted as unsigned bytes in the range 0 through 255.
00.000000r 2               ;
00.000000r 2               ;
00.000000r 2               ; SIGNED COMPARISONS
00.000000r 2               ; ------------------
00.000000r 2               ; Signed relational branches require valid N and V flags from a subtraction.
00.000000r 2               ;
00.000000r 2               ; CMP, CPX, and CPY do not modify V, so they are not sufficient by themselves
00.000000r 2               ; for a reliable signed comparison.
00.000000r 2               ;
00.000000r 2               ; Establish signed-comparison flags with binary subtraction:
00.000000r 2               ;
00.000000r 2               ;       CLD
00.000000r 2               ;       SEC
00.000000r 2               ;       LDA left_operand
00.000000r 2               ;       SBC right_operand
00.000000r 2               ;       sblt target
00.000000r 2               ;
00.000000r 2               ; The subtraction result itself does not need to be preserved. The signed
00.000000r 2               ; relationship is represented by N and V:
00.000000r 2               ;
00.000000r 2               ;       N != V      signed less than
00.000000r 2               ;       N == V      signed greater than or equal
00.000000r 2               ;
00.000000r 2               ; Values are interpreted as signed two's-complement bytes in the range
00.000000r 2               ; -128 through +127.
00.000000r 2               ;
00.000000r 2               ;
00.000000r 2               ; REGISTER AND FLAG EFFECTS
00.000000r 2               ; -------------------------
00.000000r 2               ; The branch-only macros do not modify A, X, Y, or the processor flags.
00.000000r 2               ;
00.000000r 2               ; The combined if_a_* macros execute CMP and therefore update:
00.000000r 2               ;
00.000000r 2               ;       N, Z, and C
00.000000r 2               ;
00.000000r 2               ; CMP does not modify V.
00.000000r 2               ;
00.000000r 2               ; ============================================================================
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; 1. UNSIGNED CONDITIONAL BRANCHES
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ;
00.000000r 2               ; These macros inspect flags previously established by CMP, CPX, CPY, or
00.000000r 2               ; another operation that produces equivalent Z and C flag meanings.
00.000000r 2               ;
00.000000r 2               ; They emit ordinary relative branches, so the destination must be within
00.000000r 2               ; normal 6502 branch range.
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; beq_alias target
00.000000r 2               ;
00.000000r 2               ; Branch when the compared values are equal.
00.000000r 2               ;
00.000000r 2               ; Condition:
00.000000r 2               ;       Z = 1
00.000000r 2               ;
00.000000r 2               ; Equivalent instruction:
00.000000r 2               ;       BEQ target
00.000000r 2               ;
00.000000r 2               ; Typical use:
00.000000r 2               ;       LDA value
00.000000r 2               ;       CMP #expected
00.000000r 2               ;       beq_alias matched
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro beq_alias target
00.000000r 2                   BEQ target
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; bne_alias target
00.000000r 2               ;
00.000000r 2               ; Branch when the compared values are not equal.
00.000000r 2               ;
00.000000r 2               ; Condition:
00.000000r 2               ;       Z = 0
00.000000r 2               ;
00.000000r 2               ; Equivalent instruction:
00.000000r 2               ;       BNE target
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro bne_alias target
00.000000r 2                   BNE target
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; blt target
00.000000r 2               ;
00.000000r 2               ; Branch when the left operand is less than the right operand, interpreting
00.000000r 2               ; both operands as unsigned bytes.
00.000000r 2               ;
00.000000r 2               ; Condition after CMP/CPX/CPY:
00.000000r 2               ;       C = 0
00.000000r 2               ;
00.000000r 2               ; Equivalent instruction:
00.000000r 2               ;       BCC target
00.000000r 2               ;
00.000000r 2               ; Example:
00.000000r 2               ;       LDA #10
00.000000r 2               ;       CMP #20
00.000000r 2               ;       blt less_than             ; Taken
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro blt target
00.000000r 2                   BCC target
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; bge target
00.000000r 2               ;
00.000000r 2               ; Branch when the left operand is greater than or equal to the right operand,
00.000000r 2               ; interpreting both operands as unsigned bytes.
00.000000r 2               ;
00.000000r 2               ; Condition after CMP/CPX/CPY:
00.000000r 2               ;       C = 1
00.000000r 2               ;
00.000000r 2               ; Equivalent instruction:
00.000000r 2               ;       BCS target
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro bge target
00.000000r 2                   BCS target
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; bgt target
00.000000r 2               ;
00.000000r 2               ; Branch when the left operand is strictly greater than the right operand,
00.000000r 2               ; interpreting both operands as unsigned bytes.
00.000000r 2               ;
00.000000r 2               ; Condition after CMP/CPX/CPY:
00.000000r 2               ;       C = 1 and Z = 0
00.000000r 2               ;
00.000000r 2               ; Equality is explicitly excluded before testing carry.
00.000000r 2               ;
00.000000r 2               ; Expansion:
00.000000r 2               ;       BEQ internal_skip
00.000000r 2               ;       BCS target
00.000000r 2               ;   internal_skip:
00.000000r 2               ;
00.000000r 2               ; Size:
00.000000r 2               ;       4 bytes
00.000000r 2               ;
00.000000r 2               ; Target restriction:
00.000000r 2               ;       target must be in range of the generated BCS instruction.
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro bgt target
00.000000r 2                   .local @skip
00.000000r 2               
00.000000r 2                   BEQ @skip
00.000000r 2                   BCS target
00.000000r 2               
00.000000r 2               @skip:
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; ble target
00.000000r 2               ;
00.000000r 2               ; Branch when the left operand is less than or equal to the right operand,
00.000000r 2               ; interpreting both operands as unsigned bytes.
00.000000r 2               ;
00.000000r 2               ; Condition after CMP/CPX/CPY:
00.000000r 2               ;       Z = 1 or C = 0
00.000000r 2               ;
00.000000r 2               ; Expansion:
00.000000r 2               ;       BEQ target
00.000000r 2               ;       BCC target
00.000000r 2               ;
00.000000r 2               ; Size:
00.000000r 2               ;       4 bytes
00.000000r 2               ;
00.000000r 2               ; Target restriction:
00.000000r 2               ;       target must be in range of both generated branch instructions.
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro ble target
00.000000r 2                   BEQ target
00.000000r 2                   BCC target
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; 2. SIGNED CONDITIONAL BRANCHES
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ;
00.000000r 2               ; These macros interpret the operands as signed two's-complement bytes.
00.000000r 2               ;
00.000000r 2               ; REQUIRED PRECONDITION
00.000000r 2               ; ---------------------
00.000000r 2               ; N and V must describe the result of:
00.000000r 2               ;
00.000000r 2               ;       left_operand - right_operand
00.000000r 2               ;
00.000000r 2               ; Normally establish these flags using:
00.000000r 2               ;
00.000000r 2               ;       CLD
00.000000r 2               ;       SEC
00.000000r 2               ;       LDA left_operand
00.000000r 2               ;       SBC right_operand
00.000000r 2               ;
00.000000r 2               ; Do not rely on CMP, CPX, or CPY alone because those instructions leave V
00.000000r 2               ; unchanged.
00.000000r 2               ;
00.000000r 2               ; These macros emit relative branches. The target must be within normal 6502
00.000000r 2               ; branch range from every generated branch that can reach it.
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; sbge target
00.000000r 2               ;
00.000000r 2               ; Branch when:
00.000000r 2               ;
00.000000r 2               ;       signed left_operand >= signed right_operand
00.000000r 2               ;
00.000000r 2               ; Signed condition:
00.000000r 2               ;       N == V
00.000000r 2               ;
00.000000r 2               ; Truth table:
00.000000r 2               ;
00.000000r 2               ;       V   N   Result
00.000000r 2               ;       -------------------------------
00.000000r 2               ;       0   0   branch
00.000000r 2               ;       0   1   do not branch
00.000000r 2               ;       1   0   do not branch
00.000000r 2               ;       1   1   branch
00.000000r 2               ;
00.000000r 2               ; Inputs:
00.000000r 2               ;       N and V from a preceding binary subtraction
00.000000r 2               ;
00.000000r 2               ; Preserves:
00.000000r 2               ;       A, X, Y, and all processor flags
00.000000r 2               ;
00.000000r 2               ; Target restriction:
00.000000r 2               ;       target must be in relative range of the generated BMI or BPL branch.
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro sbge target
00.000000r 2                   .local @no_overflow, @done
00.000000r 2               
00.000000r 2                   BVC @no_overflow
00.000000r 2               
00.000000r 2                   ; Overflow occurred.
00.000000r 2                   ; N=1,V=1 means N == V, so the signed result is >=.
00.000000r 2                   BMI target
00.000000r 2               
00.000000r 2                   ; N=0,V=1 means N != V, so the signed result is <.
00.000000r 2                   BPL @done
00.000000r 2               
00.000000r 2               @no_overflow:
00.000000r 2                   ; V=0. N=0 means N == V, so the signed result is >=.
00.000000r 2                   BPL target
00.000000r 2               
00.000000r 2               @done:
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; sblt target
00.000000r 2               ;
00.000000r 2               ; Branch when:
00.000000r 2               ;
00.000000r 2               ;       signed left_operand < signed right_operand
00.000000r 2               ;
00.000000r 2               ; Signed condition:
00.000000r 2               ;       N != V
00.000000r 2               ;
00.000000r 2               ; This is strictly less-than. Equality does not branch.
00.000000r 2               ;
00.000000r 2               ; Truth table:
00.000000r 2               ;
00.000000r 2               ;       V   N   Result
00.000000r 2               ;       -------------------------------
00.000000r 2               ;       0   0   do not branch
00.000000r 2               ;       0   1   branch
00.000000r 2               ;       1   0   branch
00.000000r 2               ;       1   1   do not branch
00.000000r 2               ;
00.000000r 2               ; Inputs:
00.000000r 2               ;       N and V from a preceding binary subtraction
00.000000r 2               ;
00.000000r 2               ; Preserves:
00.000000r 2               ;       A, X, Y, and all processor flags
00.000000r 2               ;
00.000000r 2               ; Target restriction:
00.000000r 2               ;       target must be in relative range of the generated BPL or BMI branch.
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro sblt target
00.000000r 2                   .local @no_overflow, @done
00.000000r 2               
00.000000r 2                   BVC @no_overflow
00.000000r 2               
00.000000r 2                   ; Overflow occurred.
00.000000r 2                   ; N=0,V=1 means N != V, so the signed result is <.
00.000000r 2                   BPL target
00.000000r 2               
00.000000r 2                   ; N=1,V=1 means N == V, so the signed result is >=.
00.000000r 2                   BMI @done
00.000000r 2               
00.000000r 2               @no_overflow:
00.000000r 2                   ; V=0. N=1 means N != V, so the signed result is <.
00.000000r 2                   BMI target
00.000000r 2               
00.000000r 2               @done:
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; sble target
00.000000r 2               ;
00.000000r 2               ; Branch when:
00.000000r 2               ;
00.000000r 2               ;       signed left_operand <= signed right_operand
00.000000r 2               ;
00.000000r 2               ; Required setup:
00.000000r 2               ;
00.000000r 2               ;       CLD
00.000000r 2               ;       SEC
00.000000r 2               ;       LDA left_operand
00.000000r 2               ;       SBC right_operand
00.000000r 2               ;       sble target
00.000000r 2               ;
00.000000r 2               ; Signed condition:
00.000000r 2               ;
00.000000r 2               ;       Z = 1 or N != V
00.000000r 2               ;
00.000000r 2               ; CMP, CPX, and CPY are not sufficient because they do not update V.
00.000000r 2               ;
00.000000r 2               ; Preserves:
00.000000r 2               ;       A, X, Y, and all processor flags
00.000000r 2               ;
00.000000r 2               ; Target restriction:
00.000000r 2               ;       target must be within relative branch range of both the generated
00.000000r 2               ;       BEQ instruction and the branches generated by sblt.
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro sble target
00.000000r 2                   BEQ target
00.000000r 2                   sblt target
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; 3. COMBINED COMPARE-AND-BRANCH HELPERS
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ;
00.000000r 2               ; These macros compare A against an immediate 8-bit value and then perform an
00.000000r 2               ; unsigned conditional branch.
00.000000r 2               ;
00.000000r 2               ; Syntax:
00.000000r 2               ;
00.000000r 2               ;       if_a_<relation> value, target
00.000000r 2               ;
00.000000r 2               ; Example:
00.000000r 2               ;
00.000000r 2               ;       LDA item_count
00.000000r 2               ;       if_a_ge 10, enough_items
00.000000r 2               ;
00.000000r 2               ; The value argument is written without '#'. Each macro supplies the immediate
00.000000r 2               ; addressing marker itself:
00.000000r 2               ;
00.000000r 2               ;       Correct:    if_a_eq $20, target
00.000000r 2               ;       Incorrect:  if_a_eq #$20, target
00.000000r 2               ;
00.000000r 2               ; Effects:
00.000000r 2               ;       A is preserved.
00.000000r 2               ;       X and Y are preserved.
00.000000r 2               ;       N, Z, and C are replaced by the result of CMP.
00.000000r 2               ;       V is unchanged.
00.000000r 2               ;
00.000000r 2               ; These are unsigned comparisons. Their targets must be within ordinary branch
00.000000r 2               ; range.
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; if_a_eq value, target
00.000000r 2               ;
00.000000r 2               ; Compare A with an immediate value and branch when A == value.
00.000000r 2               ;
00.000000r 2               ; Condition:
00.000000r 2               ;       Z = 1
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro if_a_eq value, target
00.000000r 2                   CMP #value
00.000000r 2                   BEQ target
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; if_a_ne value, target
00.000000r 2               ;
00.000000r 2               ; Compare A with an immediate value and branch when A != value.
00.000000r 2               ;
00.000000r 2               ; Condition:
00.000000r 2               ;       Z = 0
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro if_a_ne value, target
00.000000r 2                   CMP #value
00.000000r 2                   BNE target
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; if_a_lt value, target
00.000000r 2               ;
00.000000r 2               ; Compare A with an immediate value and branch when A < value, using unsigned
00.000000r 2               ; byte ordering.
00.000000r 2               ;
00.000000r 2               ; Condition:
00.000000r 2               ;       C = 0
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro if_a_lt value, target
00.000000r 2                   CMP #value
00.000000r 2                   BCC target
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; if_a_ge value, target
00.000000r 2               ;
00.000000r 2               ; Compare A with an immediate value and branch when A >= value, using unsigned
00.000000r 2               ; byte ordering.
00.000000r 2               ;
00.000000r 2               ; Condition:
00.000000r 2               ;       C = 1
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro if_a_ge value, target
00.000000r 2                   CMP #value
00.000000r 2                   BCS target
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; if_a_gt value, target
00.000000r 2               ;
00.000000r 2               ; Compare A with an immediate value and branch when A > value, using unsigned
00.000000r 2               ; byte ordering.
00.000000r 2               ;
00.000000r 2               ; Condition:
00.000000r 2               ;       C = 1 and Z = 0
00.000000r 2               ;
00.000000r 2               ; Expansion:
00.000000r 2               ;       CMP #value
00.000000r 2               ;       BEQ internal_skip
00.000000r 2               ;       BCS target
00.000000r 2               ;   internal_skip:
00.000000r 2               ;
00.000000r 2               ; Target restriction:
00.000000r 2               ;       target must be in range of the generated BCS instruction.
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro if_a_gt value, target
00.000000r 2                   .local @skip
00.000000r 2               
00.000000r 2                   CMP #value
00.000000r 2                   BEQ @skip
00.000000r 2                   BCS target
00.000000r 2               
00.000000r 2               @skip:
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; if_a_le value, target
00.000000r 2               ;
00.000000r 2               ; Compare A with an immediate value and branch when A <= value, using unsigned
00.000000r 2               ; byte ordering.
00.000000r 2               ;
00.000000r 2               ; Condition:
00.000000r 2               ;       Z = 1 or C = 0
00.000000r 2               ;
00.000000r 2               ; Expansion:
00.000000r 2               ;       CMP #value
00.000000r 2               ;       BEQ target
00.000000r 2               ;       BCC target
00.000000r 2               ;
00.000000r 2               ; Target restriction:
00.000000r 2               ;       target must be in range of both generated branch instructions.
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro if_a_le value, target
00.000000r 2                   CMP #value
00.000000r 2                   BEQ target
00.000000r 2                   BCC target
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ============================================================================
00.000000r 2               ; 4. SMART LONG CONDITIONAL JUMPS
00.000000r 2               ; ============================================================================
00.000000r 2               ;
00.000000r 2               ; The 6502 has no native long conditional branch. These macros synthesize one
00.000000r 2               ; by branching over an absolute JMP when the condition is false:
00.000000r 2               ;
00.000000r 2               ;       inverse_condition internal_skip
00.000000r 2               ;       JMP target
00.000000r 2               ;   internal_skip:
00.000000r 2               ;
00.000000r 2               ; Properties:
00.000000r 2               ;
00.000000r 2               ;   - The destination is not limited to relative branch range.
00.000000r 2               ;   - The destination must still be reachable by an absolute JMP in the
00.000000r 2               ;     current 16-bit address space.
00.000000r 2               ;   - A, X, Y, and processor flags are preserved.
00.000000r 2               ;   - Each macro normally emits 5 bytes.
00.000000r 2               ;
00.000000r 2               ; When the destination is already in ordinary branch range, a native branch
00.000000r 2               ; uses only 2 bytes and is generally faster. check_branch_distance emits an
00.000000r 2               ; assembly-time optimization message for that case.
00.000000r 2               ;
00.000000r 2               ; DISTANCE-CHECK LIMITATION
00.000000r 2               ; -------------------------
00.000000r 2               ; The target expression must be resolvable as a constant when ca65 evaluates
00.000000r 2               ; check_branch_distance. This generally works for known labels in the same
00.000000r 2               ; segment, especially backward targets.
00.000000r 2               ;
00.000000r 2               ; An unresolved, imported, or otherwise non-constant target may cause ca65 to
00.000000r 2               ; report:
00.000000r 2               ;
00.000000r 2               ;       Constant expression expected
00.000000r 2               ;
00.000000r 2               ; In such cases, remove or disable the distance check for that invocation while
00.000000r 2               ; retaining the long-jump implementation.
00.000000r 2               ; ============================================================================
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; check_branch_distance target_label, macro_name, short_name
00.000000r 2               ;
00.000000r 2               ; Internal diagnostic helper used by the long conditional jump macros.
00.000000r 2               ;
00.000000r 2               ; Parameters:
00.000000r 2               ;
00.000000r 2               ;   target_label
00.000000r 2               ;       Destination whose displacement is checked.
00.000000r 2               ;
00.000000r 2               ;   macro_name
00.000000r 2               ;       String used to identify the current long-jump macro in the diagnostic.
00.000000r 2               ;
00.000000r 2               ;   short_name
00.000000r 2               ;       String naming the equivalent native relative branch.
00.000000r 2               ;
00.000000r 2               ; Behavior:
00.000000r 2               ;
00.000000r 2               ;   - Produces an assembly error when target_label is blank.
00.000000r 2               ;   - Emits an optimization message when the target falls within the native
00.000000r 2               ;     branch displacement range.
00.000000r 2               ;   - Emits no code.
00.000000r 2               ;
00.000000r 2               ; The displacement is measured from the address immediately after a normal
00.000000r 2               ; two-byte relative branch instruction.
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro check_branch_distance target_label, macro_name, short_name
00.000000r 2                   .ifblank target_label
00.000000r 2                       .error "Missing target label for long branch macro"
00.000000r 2                   .else
00.000000r 2                       .if (target_label - (* + 2)) >= -128 .and  (target_label - (* + 2)) <= 127
00.000000r 2                           .out .sprintf("OPTIMIZATION WARNING: %s to '%s' is in range! Use %s instead to save 3 bytes and cycles.", macro_name, .string(target_label), short_name)
00.000000r 2                       .endif
00.000000r 2                   .endif
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; jeq target
00.000000r 2               ;
00.000000r 2               ; Long jump when the compared values are equal.
00.000000r 2               ;
00.000000r 2               ; Condition:
00.000000r 2               ;       Z = 1
00.000000r 2               ;
00.000000r 2               ; Equivalent short branch:
00.000000r 2               ;       BEQ target
00.000000r 2               ;
00.000000r 2               ; Expansion:
00.000000r 2               ;       BNE internal_skip
00.000000r 2               ;       JMP target
00.000000r 2               ;   internal_skip:
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro jeq target
00.000000r 2                   check_branch_distance target, "JEQ", "BEQ"
00.000000r 2                   .local @skip
00.000000r 2               
00.000000r 2                   BNE @skip
00.000000r 2                   JMP target
00.000000r 2               
00.000000r 2               @skip:
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; jne target
00.000000r 2               ;
00.000000r 2               ; Long jump when the compared values are not equal.
00.000000r 2               ;
00.000000r 2               ; Condition:
00.000000r 2               ;       Z = 0
00.000000r 2               ;
00.000000r 2               ; Equivalent short branch:
00.000000r 2               ;       BNE target
00.000000r 2               ;
00.000000r 2               ; Expansion:
00.000000r 2               ;       BEQ internal_skip
00.000000r 2               ;       JMP target
00.000000r 2               ;   internal_skip:
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro jne target
00.000000r 2                   check_branch_distance target, "JNE", "BNE"
00.000000r 2                   .local @skip
00.000000r 2               
00.000000r 2                   BEQ @skip
00.000000r 2                   JMP target
00.000000r 2               
00.000000r 2               @skip:
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; jlt target
00.000000r 2               ;
00.000000r 2               ; Long jump when the left operand is less than the right operand, interpreting
00.000000r 2               ; both operands as unsigned bytes.
00.000000r 2               ;
00.000000r 2               ; Condition after CMP/CPX/CPY:
00.000000r 2               ;       C = 0
00.000000r 2               ;
00.000000r 2               ; Equivalent short branch:
00.000000r 2               ;       BCC target
00.000000r 2               ;
00.000000r 2               ; Expansion:
00.000000r 2               ;       BCS internal_skip
00.000000r 2               ;       JMP target
00.000000r 2               ;   internal_skip:
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro jlt target
00.000000r 2                   check_branch_distance target, "JLT", "BCC"
00.000000r 2                   .local @skip
00.000000r 2               
00.000000r 2                   BCS @skip
00.000000r 2                   JMP target
00.000000r 2               
00.000000r 2               @skip:
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               ; jge target
00.000000r 2               ;
00.000000r 2               ; Long jump when the left operand is greater than or equal to the right operand,
00.000000r 2               ; interpreting both operands as unsigned bytes.
00.000000r 2               ;
00.000000r 2               ; Condition after CMP/CPX/CPY:
00.000000r 2               ;       C = 1
00.000000r 2               ;
00.000000r 2               ; Equivalent short branch:
00.000000r 2               ;       BCS target
00.000000r 2               ;
00.000000r 2               ; Expansion:
00.000000r 2               ;       BCC internal_skip
00.000000r 2               ;       JMP target
00.000000r 2               ;   internal_skip:
00.000000r 2               ; ----------------------------------------------------------------------------
00.000000r 2               
00.000000r 2               .macro jge target
00.000000r 2                   check_branch_distance target, "JGE", "BCS"
00.000000r 2                   .local @skip
00.000000r 2               
00.000000r 2                   BCC @skip
00.000000r 2                   JMP target
00.000000r 2               
00.000000r 2               @skip:
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 1                   .include "math.inc"
00.000000r 2               ; ============================================================================
00.000000r 2               ; 16-BIT SYNTHETIC MACRO SUITE FOR CA65
00.000000r 2               ; ============================================================================
00.000000r 2               
00.000000r 2               ;; ---------------------------------------------------------------------------
00.000000r 2               ; Load a 16-bit word into a pointer
00.000000r 2               ; Usage: INC16 dest, immediate value
00.000000r 2               ;; ---------------------------------------------------------------------------
00.000000r 2               .macro load16 PTR, IMM
00.000000r 2                   LDA #<IMM
00.000000r 2                   STA PTR
00.000000r 2                   LDA #>IMM
00.000000r 2                   STA PTR + 1
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               ;; ---------------------------------------------------------------------------
00.000000r 2               ; Increment 16-bit word at memory location
00.000000r 2               ; Usage: INC16 ptr
00.000000r 2               ;; ---------------------------------------------------------------------------
00.000000r 2               .macro inc16 ptr
00.000000r 2                   .local @skip
00.000000r 2                   INC ptr
00.000000r 2                   BNE @skip
00.000000r 2                   INC ptr + 1
00.000000r 2               @skip:
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               ;; ---------------------------------------------------------------------------
00.000000r 2               ; Decrement 16-bit word at memory location
00.000000r 2               ; Usage: DEC16 ptr
00.000000r 2               ;; ---------------------------------------------------------------------------
00.000000r 2               .macro dec16 ptr
00.000000r 2                   .local @skip
00.000000r 2                   LDA ptr
00.000000r 2                   BNE @skip
00.000000r 2                   DEC ptr + 1
00.000000r 2               @skip:
00.000000r 2                   DEC ptr
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               ;; ---------------------------------------------------------------------------
00.000000r 2               ; 16-Bit Addition: dest = op1 + op2 (op2 can be an immediate #val or memory addr)
00.000000r 2               ; Usage: ADD16 dest, op1, op2
00.000000r 2               ;        ADD16 ptr, ptr, #40
00.000000r 2               ;        ADD16 dest, src1, src2
00.000000r 2               ;; ---------------------------------------------------------------------------
00.000000r 2               .macro add16 dest, op1, op2
00.000000r 2                   CLC
00.000000r 2                   .if (.match ({op2}, {#}))
00.000000r 2                   ; Immediate operand case (e.g., #$E000)
00.000000r 2                   LDA op1
00.000000r 2                   ADC #<(.right (1, {op2}))
00.000000r 2                   STA dest
00.000000r 2                   LDA op1 + 1
00.000000r 2                   ADC #>(.right (1, {op2}))
00.000000r 2                   STA dest + 1
00.000000r 2                   .else
00.000000r 2                   ; Memory operand case
00.000000r 2                   LDA op1
00.000000r 2                   ADC op2
00.000000r 2                   STA dest
00.000000r 2                   LDA op1 + 1
00.000000r 2                   ADC op2 + 1
00.000000r 2                   STA dest + 1
00.000000r 2                   .endif
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               
00.000000r 2               ;; ---------------------------------------------------------------------------
00.000000r 2               ; 16-Bit Addition with Immediate/Constant Value
00.000000r 2               ; Usage: ADD16I dest, op1, START_REGION_CHAR_RAM
00.000000r 2               ;        ADD16I CHAR_PTR, CHAR_PTR, 40
00.000000r 2               ;; ---------------------------------------------------------------------------
00.000000r 2               .macro add16i dest, op1, val
00.000000r 2                   CLC
00.000000r 2                   LDA op1
00.000000r 2                   ADC #<(val)
00.000000r 2                   STA dest
00.000000r 2                   LDA op1 + 1
00.000000r 2                   ADC #>(val)
00.000000r 2                   STA dest + 1
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               
00.000000r 2               ;; ---------------------------------------------------------------------------
00.000000r 2               ; 16  / 8 Bit Addition with Immediate/Constant Value
00.000000r 2               ; Usage: ADD16_8 (16 bit)dest, (16 bit)op1, (8 bit)op2
00.000000r 2               ;; ---------------------------------------------------------------------------
00.000000r 2               .macro add16_8 dest, op1, val8
00.000000r 2                   CLC
00.000000r 2                   LDA op1
00.000000r 2                   ADC val8
00.000000r 2                   STA dest
00.000000r 2                   LDA op1 + 1
00.000000r 2                   ADC #$00
00.000000r 2                   STA dest + 1
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               ;; ---------------------------------------------------------------------------
00.000000r 2               ; 16-Bit Subtraction: dest = op1 - op2
00.000000r 2               ; Usage: SUB16 dest, op1, op2
00.000000r 2               ;; ---------------------------------------------------------------------------
00.000000r 2               .macro sub16 dest, op1, op2
00.000000r 2                   SEC
00.000000r 2                   .if (.match ({op2}, {#}))
00.000000r 2                   LDA op1
00.000000r 2                   SBC #<(.right (1, {op2}))
00.000000r 2                   STA dest
00.000000r 2                   LDA op1 + 1
00.000000r 2                   SBC #>(.right (1, {op2}))
00.000000r 2                   STA dest + 1
00.000000r 2                   .else
00.000000r 2                   LDA op1
00.000000r 2                   SBC op2
00.000000r 2                   STA dest
00.000000r 2                   LDA op1 + 1
00.000000r 2                   SBC op2 + 1
00.000000r 2                   STA dest + 1
00.000000r 2                   .endif
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               .macro sub16i dest, op1, val
00.000000r 2                   SEC
00.000000r 2                   LDA op1
00.000000r 2                   SBC #<(val)
00.000000r 2                   STA dest
00.000000r 2                   LDA op1 + 1
00.000000r 2                   SBC #>(val)
00.000000r 2                   STA dest + 1
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               ;; ---------------------------------------------------------------------------
00.000000r 2               ; Shift Left 16-bit word (dest = dest << 1)
00.000000r 2               ; Usage: ASL16 ptr
00.000000r 2               ;; ---------------------------------------------------------------------------
00.000000r 2               .macro asl16 ptr
00.000000r 2                   ASL ptr
00.000000r 2                   ROL ptr + 1
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 2               ;; ---------------------------------------------------------------------------
00.000000r 2               ; Copy 16-bit word: dest = src
00.000000r 2               ; Usage: MOV16 dest, src
00.000000r 2               ;; ---------------------------------------------------------------------------
00.000000r 2               .macro mov16 dest, src
00.000000r 2                   .if (.match ({src}, {#}))
00.000000r 2                   LDA #<(.right (1, {src}))
00.000000r 2                   STA dest
00.000000r 2                   LDA #>(.right (1, {src}))
00.000000r 2                   STA dest + 1
00.000000r 2                   .else
00.000000r 2                   LDA src
00.000000r 2                   STA dest
00.000000r 2                   LDA src + 1
00.000000r 2                   STA dest + 1
00.000000r 2                   .endif
00.000000r 2               .endmacro
00.000000r 2               
00.000000r 1                   .include "hw_limits.inc"
00.000000r 2               
00.000000r 2               ; CPU clock rate in cycles per second / Hz.
00.000000r 2               ; Example: Atari NTSC-ish clock:
00.000000r 2               ; CLOCK_SPEED = 1789773
00.000000r 2               
00.000000r 2               
00.000000r 2               CLOCK_SPEED = 3000000
00.000000r 2               SCREEN_COLS =  40
00.000000r 2               SCREEN_ROWS =  24
00.000000r 2               SCREEN_SIZE = SCREEN_COLS * SCREEN_ROWS
00.000000r 2               
00.000000r 2               START_REGION_CHAR_RAM = $A000
00.000000r 2               END_REGION_CHAR_RAM = START_REGION_CHAR_RAM + SCREEN_SIZE
00.000000r 2               
00.000000r 2               START_REGION_COLOR_RAM = $B000
00.000000r 2               END_REGION_COLOR_RAM = START_REGION_COLOR_RAM + SCREEN_SIZE
00.000000r 2               
00.000000r 2               DEFAULT_COLOR = $6F
00.000000r 2               DEFAULT_SCREEN_CHAR = 181
00.000000r 2               
00.000000r 1                   .include "timer.mac"
00.000000r 2               ; The formatter has NO idea how to handle this file, so we isolate it out.
00.000000r 2               
00.000000r 2               ; ------------------------------------------------------------
00.000000r 2               ; Three bytes of zero-page scratch space.
00.000000r 2               ; This routine is not reentrant.
00.000000r 2               ; ------------------------------------------------------------
00.000000r 2               
00.000000r 2               .segment "ZEROPAGE"
04.000000r 2               
04.000000r 2               delay_count:
04.000000r 2  xx xx xx         .res 3
04.000003r 2               
04.000003r 2               
04.000003r 2               ; ------------------------------------------------------------
04.000003r 2               ; Shared 24-bit delay routine
04.000003r 2               ;
04.000003r 2               ; Input:
04.000003r 2               ;   delay_count = number of iterations, 1..$FFFFFF
04.000003r 2               ;
04.000003r 2               ; Each iteration costs:
04.000003r 2               ;   35 cycles when BNE is taken
04.000003r 2               ;   34 cycles on the final iteration
04.000003r 2               ;
04.000003r 2               ; Including RTS:
04.000003r 2               ;   35 * count + 5 cycles
04.000003r 2               ;
04.000003r 2               ; Decimal mode must be clear before entry.
04.000003r 2               ; ------------------------------------------------------------
04.000003r 2               
04.000003r 2               .segment "CODE"
00.000000r 2               
00.000000r 2               ; Keep the backward branch inside one page.
00.000000r 2               .align 32, $EA
00.000000r 2               
00.000000r 2               .proc delay_24
00.000000r 2               loop:
00.000000r 2  38               SEC                         ; 2
00.000001r 2               
00.000001r 2  A5 rr            LDA delay_count             ; 3
00.000003r 2  E9 01            SBC #1                      ; 2
00.000005r 2  85 rr            STA delay_count             ; 3
00.000007r 2               
00.000007r 2  A5 rr            LDA delay_count+1           ; 3
00.000009r 2  E9 00            SBC #0                      ; 2
00.00000Br 2  85 rr            STA delay_count+1           ; 3
00.00000Dr 2               
00.00000Dr 2  A5 rr            LDA delay_count+2           ; 3
00.00000Fr 2  E9 00            SBC #0                      ; 2
00.000011r 2  85 rr            STA delay_count+2           ; 3
00.000013r 2               
00.000013r 2  05 rr            ORA delay_count+1           ; 3
00.000015r 2  05 rr            ORA delay_count             ; 3
00.000017r 2  D0 E7            BNE loop                    ; 3 taken, 2 final
00.000019r 2               
00.000019r 2  60               RTS                         ; 6
00.00001Ar 2               .endproc
00.00001Ar 2               
00.00001Ar 2               ; The macro calculates the required CPU cycles without directly
00.00001Ar 2               ; multiplying CLOCK_SPEED * milliseconds, which could overflow an
00.00001Ar 2               ; assembler limited to 32-bit intermediate values for sufficiently long delays.
00.00001Ar 2               
00.00001Ar 2               ; ------------------------------------------------------------
00.00001Ar 2               ; pause_ms milliseconds
00.00001Ar 2               ;
00.00001Ar 2               ; Examples:
00.00001Ar 2               ;
00.00001Ar 2               ;     pause_ms 10       ; 10 milliseconds
00.00001Ar 2               ;     pause_ms 10000    ; 10 seconds
00.00001Ar 2               ;
00.00001Ar 2               ; Preserves:
00.00001Ar 2               ;     A and processor flags
00.00001Ar 2               ;
00.00001Ar 2               ; Unchanged:
00.00001Ar 2               ;     X and Y
00.00001Ar 2               ;
00.00001Ar 2               ; Uses:
00.00001Ar 2               ;     Two stack bytes
00.00001Ar 2               ;     delay_count through delay_count+2
00.00001Ar 2               ;
00.00001Ar 2               ; Timing:
00.00001Ar 2               ;     Rounded to the nearest CPU cycle
00.00001Ar 2               ; ------------------------------------------------------------
00.00001Ar 2               
00.00001Ar 2               .macro pause_ms milliseconds
00.00001Ar 2               .scope
00.00001Ar 2               
00.00001Ar 2                   ; Calculate:
00.00001Ar 2                   ;
00.00001Ar 2                   ;     round(CLOCK_SPEED * milliseconds / 1000)
00.00001Ar 2                   ;
00.00001Ar 2                   ; Splitting CLOCK_SPEED avoids a large intermediate product.
00.00001Ar 2               
00.00001Ar 2                   target_cycles = ((::CLOCK_SPEED / 1000) * (milliseconds)) + ((((::CLOCK_SPEED .mod 1000) * (milliseconds)) + 500) / 1000)
00.00001Ar 2               
00.00001Ar 2                   ; Macro overhead plus delay_24:
00.00001Ar 2                   ;
00.00001Ar 2                   ;   PHP                 3
00.00001Ar 2                   ;   PHA                 3
00.00001Ar 2                   ;   CLD                 2
00.00001Ar 2                   ;   Three LDA/STA pairs 15
00.00001Ar 2                   ;   JSR                 6
00.00001Ar 2                   ;   delay_24            35*n + 5
00.00001Ar 2                   ;   PLA                 4
00.00001Ar 2                   ;   PLP                 4
00.00001Ar 2                   ;
00.00001Ar 2                   ; Total:
00.00001Ar 2                   ;
00.00001Ar 2                   ;   35*n + 42 cycles
00.00001Ar 2               
00.00001Ar 2                   iterations .set (target_cycles - 42) / 35
00.00001Ar 2                   padding    .set target_cycles - ((iterations * 35) + 42)
00.00001Ar 2               
00.00001Ar 2                   ; There is no one-cycle 6502 instruction. If exactly one
00.00001Ar 2                   ; padding cycle remains, remove one loop iteration and turn
00.00001Ar 2                   ; the remainder into 36 cycles.
00.00001Ar 2               
00.00001Ar 2                   .if padding = 1
00.00001Ar 2                       iterations .set iterations - 1
00.00001Ar 2                       padding    .set padding + 35
00.00001Ar 2                   .endif
00.00001Ar 2               
00.00001Ar 2                   .assert target_cycles >= 112, error,                                      "pause_ms delay is too short"
00.00001Ar 2               
00.00001Ar 2                   .assert iterations >= 1, error,                                           "pause_ms requires at least one delay iteration"
00.00001Ar 2               
00.00001Ar 2                   .assert iterations <= $FFFFFF, error,                                     "pause_ms delay exceeds the 24-bit counter"
00.00001Ar 2               
00.00001Ar 2                   PHP
00.00001Ar 2                   PHA
00.00001Ar 2                   CLD
00.00001Ar 2               
00.00001Ar 2                   LDA #<iterations
00.00001Ar 2                   STA delay_count
00.00001Ar 2               
00.00001Ar 2                   LDA #>iterations
00.00001Ar 2                   STA delay_count+1
00.00001Ar 2               
00.00001Ar 2                   LDA #^iterations
00.00001Ar 2                   STA delay_count+2
00.00001Ar 2               
00.00001Ar 2                   JSR delay_24
00.00001Ar 2               
00.00001Ar 2                   ; Generate the remaining 0..36 cycles.
00.00001Ar 2                   ;
00.00001Ar 2                   ; NOP zp? No: ordinary NOP is 2 cycles.
00.00001Ar 2                   ; BIT zp is 3 cycles. The saved flags are restored afterward.
00.00001Ar 2               
00.00001Ar 2                   .if padding .mod 2
00.00001Ar 2                       BIT delay_count            ; 3 cycles
00.00001Ar 2               
00.00001Ar 2                       .repeat (padding - 3) / 2
00.00001Ar 2                           NOP                    ; 2 cycles
00.00001Ar 2                       .endrepeat
00.00001Ar 2                   .else
00.00001Ar 2                       .repeat padding / 2
00.00001Ar 2                           NOP                    ; 2 cycles
00.00001Ar 2                       .endrepeat
00.00001Ar 2                   .endif
00.00001Ar 2               
00.00001Ar 2                   PLA
00.00001Ar 2                   PLP
00.00001Ar 2               
00.00001Ar 2               .endscope
00.00001Ar 2               .endmacro
00.00001Ar 2               
00.00001Ar 2               
00.00001Ar 1               
00.00001Ar 1                   .export _irq_handler
00.00001Ar 1                   .export _reset_handler
00.00001Ar 1                   .export _nmi_handler
00.00001Ar 1                   .export JTCLS
00.00001Ar 1                   .exportzp CURS_COL
00.00001Ar 1                   .exportzp CURS_ROW
00.00001Ar 1               
00.00001Ar 1                   .segment "CODE"
00.00001Ar 1               
00.00001Ar 1               .macro pstring str
00.00001Ar 1                   .byte .strlen(str), str
00.00001Ar 1               .endmacro
00.00001Ar 1               
00.00001Ar 1               
00.00001Ar 1               .macro pstring2 payload
00.00001Ar 1                   .local data_start, data_end
00.00001Ar 1               
00.00001Ar 1                   ; Pascal-string length byte
00.00001Ar 1                   .byte data_end - data_start
00.00001Ar 1               
00.00001Ar 1               data_start:
00.00001Ar 1                   .byte payload
00.00001Ar 1               data_end:
00.00001Ar 1               
00.00001Ar 1                   .assert (data_end - data_start) <= $FF, error, "pstring2 payload exceeds 255 bytes"
00.00001Ar 1               .endmacro
00.00001Ar 1               
00.00001Ar 1               .macro push_ptr P
00.00001Ar 1                   LDA P
00.00001Ar 1                   PHA
00.00001Ar 1                   LDA P + 1
00.00001Ar 1                   PHA
00.00001Ar 1               .endmacro
00.00001Ar 1               
00.00001Ar 1               .macro pop_ptr P
00.00001Ar 1                   PLA
00.00001Ar 1                   STA P + 1
00.00001Ar 1                   PLA
00.00001Ar 1                   STA P
00.00001Ar 1               .endmacro
00.00001Ar 1               
00.00001Ar 1               .macro pushall
00.00001Ar 1               ; Important note for reviewers:
00.00001Ar 1               ;
00.00001Ar 1               ; The pushall/popall pair preserves A, X, Y, and processor status.
00.00001Ar 1               ;
00.00001Ar 1               ; Unlike a conventional register-save sequence, pushall restores the
00.00001Ar 1               ; original value of A before completing. This allows A to remain a live
00.00001Ar 1               ; argument for a function called between pushall and popall.
00.00001Ar 1               ;
00.00001Ar 1               ; This implementation uses SAVEA and is intentionally not interrupt-reentrant.
00.00001Ar 1               
00.00001Ar 1                   PHP                                 ; Push status register
00.00001Ar 1                   STA SAVEA                           ; Save the 'A' register while storing the others
00.00001Ar 1                   PHA                                 ; Push A
00.00001Ar 1                   TXA                                 ; X -> A
00.00001Ar 1                   PHA                                 ; Push X value in A
00.00001Ar 1                   TYA                                 ; Y -> A
00.00001Ar 1                   PHA                                 ; PUSH Y value in A
00.00001Ar 1                   LDA SAVEA                           ; And get our original 'A' back
00.00001Ar 1               .endmacro
00.00001Ar 1               
00.00001Ar 1               .macro popall
00.00001Ar 1                   PLA                                 ; Get the pushed Y value
00.00001Ar 1                   TAY                                 ; Transfer to Y
00.00001Ar 1                   PLA                                 ; Get the pushed X value
00.00001Ar 1                   TAX                                 ; Transfer to X
00.00001Ar 1                   PLA                                 ; And then get A
00.00001Ar 1                   PLP                                 ; Pull status register
00.00001Ar 1               .endmacro
00.00001Ar 1               
00.00001Ar 1               .segment "ZEROPAGE"
04.000003r 1  xx xx        TMP_PTR: .res 2
04.000005r 1  xx xx        DISPLAY_PTR: .res 2
04.000007r 1  xx           FILCHAR: .res 1
04.000008r 1  xx           SAVEA: .res 1
04.000009r 1               
04.000009r 1               ; Cursor X position
04.000009r 1  xx           CURS_COL: .res 1
04.00000Ar 1               ; Cursor Y position
04.00000Ar 1  xx           CURS_ROW: .res 1
04.00000Br 1               ; Current color
04.00000Br 1  xx           CURRENT_COLOR: .res 1
04.00000Cr 1               ; CHAR ram ptr
04.00000Cr 1  xx xx        CHAR_PTR: .res 2
04.00000Er 1               ; COLOR ram ptr
04.00000Er 1  xx xx        COLOR_PTR: .res 2
04.000010r 1               
04.000010r 1                   .segment "CODE"
00.00001Ar 1               
00.00001Ar 1               .proc DUMMY_ROUTINE
00.00001Ar 1  60               RTS
00.00001Br 1               .endproc
00.00001Br 1               
00.00001Br 1               ; ============================================================================
00.00001Br 1               ; Routine: DISPLAY_PSTRING
00.00001Br 1               ; Description:
00.00001Br 1               ;   Displays a Pascal-style string (length byte followed by character payload).
00.00001Br 1               ;   Advances CURS_COL and CURS_ROW automatically per character.
00.00001Br 1               ;
00.00001Br 1               ; Inputs:
00.00001Br 1               ;   DISPLAY_PTR (2 bytes, Zero Page) - Pointer to the start of the PSTRING (length byte)
00.00001Br 1               ;
00.00001Br 1               ; Registers Modified:
00.00001Br 1               ;   A, X, Y
00.00001Br 1               ; ============================================================================
00.00001Br 1               .proc DISPLAY_PSTRING
00.00001Br 1  A0 00            LDY #$00
00.00001Dr 1  B1 rr            LDA (DISPLAY_PTR), Y                ; Read 1-byte string length
00.00001Fr 1  AA               TAX                                 ; Store length in X
00.000020r 1  F0 1B            BEQ @done                           ; Early exit if length is 0
00.000022r 1               
00.000022r 1               @loop:
00.000022r 1  C8               INY                                 ; Advance offset to the next character (starts at index 1)
00.000023r 1  B1 rr            LDA (DISPLAY_PTR), Y                ; Fetch character
00.000025r 1               
00.000025r 1                   pushall
00.000025r 0  08           >  PHP 
00.000026r 0  85 rr        >  STA SAVEA 
00.000028r 0  48           >  PHA 
00.000029r 0  8A           >  TXA 
00.00002Ar 0  48           >  PHA 
00.00002Br 0  98           >  TYA 
00.00002Cr 0  48           >  PHA 
00.00002Dr 0  A5 rr        >  LDA SAVEA 
00.00002Fr 1  A2 00            LDX #$00                            ; Display mode processed special chars.
00.000031r 1  20 rr rr         JSR DISPLAY_CHAR                    ; Draw character & advance cursor
00.000034r 1                   popall
00.000034r 0  68           >  PLA 
00.000035r 0  A8           >  TAY 
00.000036r 0  68           >  PLA 
00.000037r 0  AA           >  TAX 
00.000038r 0  68           >  PLA 
00.000039r 0  28           >  PLP 
00.00003Ar 1               
00.00003Ar 1  CA               DEX                                 ; Decrement remaining byte count
00.00003Br 1  D0 E5            BNE @loop                           ; Continue until X reaches 0
00.00003Dr 1               
00.00003Dr 1               @done:
00.00003Dr 1  60               RTS
00.00003Er 1               .endproc
00.00003Er 1               
00.00003Er 1               
00.00003Er 1               ; ASCII/control character values
00.00003Er 1               CHAR_BEL = $07
00.00003Er 1               CHAR_BS  = $08
00.00003Er 1               CHAR_TAB = $09
00.00003Er 1               CHAR_LF  = $0A
00.00003Er 1               CHAR_FF  = $0C
00.00003Er 1               CHAR_CR  = $0D
00.00003Er 1               CHAR_DEL = $7F
00.00003Er 1               
00.00003Er 1               ; ============================================================================
00.00003Er 1               ; Routine: DISPLAY_CHAR
00.00003Er 1               ; Description:
00.00003Er 1               ;   Plots a single character to the screen at position (CURS_COL, CURS_ROW), updates
00.00003Er 1               ;   the corresponding tile in color RAM with CURRENT_COLOR, and advances
00.00003Er 1               ;   the cursor (wrapping to the next row if X reaches column 40).
00.00003Er 1               ;
00.00003Er 1               ; Inputs:
00.00003Er 1               ;   A                - Character code to write to screen
00.00003Er 1               ;   X                - 0 = Handle special characters (NL, etc).
00.00003Er 1               ;                    - 1 = raw
00.00003Er 1               ;   CURS_COL         - Screen X coordinate
00.00003Er 1               ;   CURS_ROW         - Screen Y coordinate
00.00003Er 1               ;   CURRENT_COLOR - Color code to write to Color RAM
00.00003Er 1               ; ============================================================================
00.00003Er 1               .proc DISPLAY_CHAR
00.00003Er 1               
00.00003Er 1               ; Raw mode bypasses all control-character interpretation.
00.00003Er 1  E0 00            CPX #$00
00.000040r 1  D0 20            BNE @draw_character
00.000042r 1               
00.000042r 1  C9 07            CMP #CHAR_BEL
00.000044r 1  F0 39            BEQ @bell
00.000046r 1               
00.000046r 1  C9 0A            CMP #CHAR_LF
00.000048r 1  F0 36            BEQ @newline
00.00004Ar 1               
00.00004Ar 1  C9 0D            CMP #CHAR_CR
00.00004Cr 1  F0 36            BEQ @carriage_return
00.00004Er 1               
00.00004Er 1  C9 08            CMP #CHAR_BS
00.000050r 1  F0 37            BEQ @backspace
00.000052r 1               
00.000052r 1  C9 09            CMP #CHAR_TAB
00.000054r 1  F0 3A            BEQ @tab
00.000056r 1               
00.000056r 1  C9 0C            CMP #CHAR_FF
00.000058r 1  F0 48            BEQ @form_feed
00.00005Ar 1               
00.00005Ar 1                   ; Ignore unsupported C0 control characters in processed mode.
00.00005Ar 1  C9 20            CMP #$20
00.00005Cr 1  90 20            BCC @done
00.00005Er 1               
00.00005Er 1                   ; Optionally treat DEL as non-printing.
00.00005Er 1  C9 7F            CMP #CHAR_DEL
00.000060r 1  F0 1C            BEQ @done
00.000062r 1               
00.000062r 1                   ; --------------------------------------------------------------------
00.000062r 1                   ; Printable character path
00.000062r 1                   ; --------------------------------------------------------------------
00.000062r 1               @draw_character:
00.000062r 1  48               PHA                                 ; Save character
00.000063r 1               
00.000063r 1                   ; 1. Check if we need to scroll/wrap BEFORE drawing the character
00.000063r 1  A5 rr            LDA CURS_COL
00.000065r 1  C9 28            CMP #SCREEN_COLS
00.000067r 1  90 03            BCC @ready_to_draw
00.000069r 1               
00.000069r 1                   ; If CURS_COL >= SCREEN_COLS, wrap line before printing this character
00.000069r 1  20 rr rr         JSR DISPLAY_NEXT_LINE
00.00006Cr 1               
00.00006Cr 1               @ready_to_draw:
00.00006Cr 1               ; 2. Calculate cursor location and draw character
00.00006Cr 1  20 rr rr         JSR SET_CURSOR
00.00006Fr 1               
00.00006Fr 1  A0 00            LDY #$00
00.000071r 1  68               PLA
00.000072r 1               
00.000072r 1                   ; We not have the *print* character we want, look up the
00.000072r 1                   ; *screen code*
00.000072r 1               
00.000072r 1  AA               TAX                                 ; Transfer to X
00.000073r 1  BD rr rr         LDA p2slookup, X                    ; Lookup the new screen code
00.000076r 1               
00.000076r 1  91 rr            STA (CHAR_PTR), Y
00.000078r 1  A5 rr            LDA CURRENT_COLOR
00.00007Ar 1  91 rr            STA (COLOR_PTR), Y
00.00007Cr 1               
00.00007Cr 1                   ; 3. Advance cursor X position
00.00007Cr 1  E6 rr            INC CURS_COL
00.00007Er 1               @done:
00.00007Er 1  60               RTS
00.00007Fr 1               
00.00007Fr 1                   ; --------------------------------------------------------------------
00.00007Fr 1                   ; Control-character handlers
00.00007Fr 1                   ; --------------------------------------------------------------------
00.00007Fr 1               
00.00007Fr 1               @bell:
00.00007Fr 1               ;JSR RING_BELL               ; Hardware-specific routine
00.00007Fr 1  60               RTS                                 ; Cursor and pending wrap unchanged
00.000080r 1               
00.000080r 1               @newline:
00.000080r 1  20 rr rr         JSR DISPLAY_NEXT_LINE               ; CR+LF semantics in this implementation
00.000083r 1  60               RTS
00.000084r 1               
00.000084r 1               @carriage_return:
00.000084r 1  A9 00            LDA #$00
00.000086r 1  85 rr            STA CURS_COL
00.000088r 1  60               RTS
00.000089r 1               
00.000089r 1               @backspace:
00.000089r 1  A5 rr            LDA CURS_COL
00.00008Br 1  F0 F1            BEQ @done
00.00008Dr 1  C6 rr            DEC CURS_COL
00.00008Fr 1  60               RTS
00.000090r 1               
00.000090r 1               @tab:
00.000090r 1               ; Advance to the next 8-column tab stop.
00.000090r 1               ; This may leave CURS_COL == SCREEN_COLS, creating pending wrap.
00.000090r 1  A5 rr            LDA CURS_COL
00.000092r 1  18               CLC
00.000093r 1  69 08            ADC #8
00.000095r 1  29 F8            AND #$F8
00.000097r 1  85 rr            STA CURS_COL
00.000099r 1               
00.000099r 1                   ; Clamp malformed values beyond the right edge.
00.000099r 1  C9 28            CMP #SCREEN_COLS
00.00009Br 1  90 E1            BCC @done
00.00009Dr 1  A9 28            LDA #SCREEN_COLS
00.00009Fr 1  85 rr            STA CURS_COL
00.0000A1r 1  60               RTS
00.0000A2r 1               
00.0000A2r 1               @form_feed:
00.0000A2r 1  20 rr rr         JSR CLEAR_SCREEN
00.0000A5r 1  60               RTS
00.0000A6r 1               .endproc
00.0000A6r 1               
00.0000A6r 1               ; ============================================================================
00.0000A6r 1               ; Routine: DISPLAY_NEXT_LINE
00.0000A6r 1               ; Description:
00.0000A6r 1               ;   Resets CURS_COL to 0 and advances CURS_ROW to the next line.
00.0000A6r 1               ; ============================================================================
00.0000A6r 1               .proc DISPLAY_NEXT_LINE
00.0000A6r 1                   pushall
00.0000A6r 0  08           >  PHP 
00.0000A7r 0  85 rr        >  STA SAVEA 
00.0000A9r 0  48           >  PHA 
00.0000AAr 0  8A           >  TXA 
00.0000ABr 0  48           >  PHA 
00.0000ACr 0  98           >  TYA 
00.0000ADr 0  48           >  PHA 
00.0000AEr 0  A5 rr        >  LDA SAVEA 
00.0000B0r 1  A9 00            LDA #$00
00.0000B2r 1  85 rr            STA CURS_COL                        ; Reset X to left margin
00.0000B4r 1               
00.0000B4r 1  E6 rr            INC CURS_ROW                        ; Move down one line
00.0000B6r 1  A5 rr            LDA CURS_ROW
00.0000B8r 1  C9 18            CMP #SCREEN_ROWS
00.0000BAr 1  90 03            BCC @noscroll                       ; CURS_ROW < SCREEN_ROWS
00.0000BCr 1  20 rr rr         JSR SCROLL_UP
00.0000BFr 1               @noscroll:
00.0000BFr 1                   popall
00.0000BFr 0  68           >  PLA 
00.0000C0r 0  A8           >  TAY 
00.0000C1r 0  68           >  PLA 
00.0000C2r 0  AA           >  TAX 
00.0000C3r 0  68           >  PLA 
00.0000C4r 0  28           >  PLP 
00.0000C5r 1  60               RTS
00.0000C6r 1               .endproc
00.0000C6r 1               
00.0000C6r 1               ; ============================================================================
00.0000C6r 1               ; Compile-Time Calculated Constants for Scrolling
00.0000C6r 1               ; ============================================================================
00.0000C6r 1               ; Copy rows 1..23 into rows 0..22.
00.0000C6r 1               ; The final row is cleared separately.
00.0000C6r 1               TOTAL_SCROLL_BYTES = (SCREEN_ROWS - 1) * SCREEN_COLS
00.0000C6r 1               PAGES_TO_COPY = TOTAL_SCROLL_BYTES >> 8
00.0000C6r 1               REM_BYTES_TO_COPY = TOTAL_SCROLL_BYTES & $FF
00.0000C6r 1               BOTTOM_ROW_OFFSET = (SCREEN_ROWS - 1) * SCREEN_COLS
00.0000C6r 1               
00.0000C6r 1               ; ============================================================================
00.0000C6r 1               ; Routine: SCROLL_UP
00.0000C6r 1               ; Description:
00.0000C6r 1               ;   Shifts screen RAM (Char & Color) up by 1 row.
00.0000C6r 1               ;   Clears the bottom row and clamps CURS_ROW to SCREEN_ROWS - 1.
00.0000C6r 1               ; ============================================================================
00.0000C6r 1               .proc SCROLL_UP
00.0000C6r 1                   pushall
00.0000C6r 0  08           >  PHP 
00.0000C7r 0  85 rr        >  STA SAVEA 
00.0000C9r 0  48           >  PHA 
00.0000CAr 0  8A           >  TXA 
00.0000CBr 0  48           >  PHA 
00.0000CCr 0  98           >  TYA 
00.0000CDr 0  48           >  PHA 
00.0000CEr 0  A5 rr        >  LDA SAVEA 
00.0000D0r 1                   push_ptr DISPLAY_PTR
00.0000D0r 0  A5 rr        >  LDA P
00.0000D2r 0  48           >  PHA
00.0000D3r 0  A5 rr        >  LDA P + 1
00.0000D5r 0  48           >  PHA
00.0000D6r 1                   push_ptr TMP_PTR
00.0000D6r 0  A5 rr        >  LDA P
00.0000D8r 0  48           >  PHA
00.0000D9r 0  A5 rr        >  LDA P + 1
00.0000DBr 0  48           >  PHA
00.0000DCr 1               
00.0000DCr 1                   ; --------------------------------------------------------------------
00.0000DCr 1                   ; Step 1: Scroll Character RAM
00.0000DCr 1                   ; --------------------------------------------------------------------
00.0000DCr 1                   load16 DISPLAY_PTR, (START_REGION_CHAR_RAM + SCREEN_COLS)
00.0000DCr 0  A9 28        >  LDA #<IMM
00.0000DEr 0  85 rr        >  STA PTR
00.0000E0r 0  A9 A0        >  LDA #>IMM
00.0000E2r 0  85 rr        >  STA PTR + 1
00.0000E4r 1                   load16 TMP_PTR, START_REGION_CHAR_RAM
00.0000E4r 0  A9 00        >  LDA #<IMM
00.0000E6r 0  85 rr        >  STA PTR
00.0000E8r 0  A9 A0        >  LDA #>IMM
00.0000EAr 0  85 rr        >  STA PTR + 1
00.0000ECr 1               
00.0000ECr 1  20 rr rr         JSR copy_vram_block
00.0000EFr 1               
00.0000EFr 1                   ; --------------------------------------------------------------------
00.0000EFr 1                   ; Step 2: Scroll Color RAM
00.0000EFr 1                   ; --------------------------------------------------------------------
00.0000EFr 1                   load16 DISPLAY_PTR, (START_REGION_COLOR_RAM + SCREEN_COLS)
00.0000EFr 0  A9 28        >  LDA #<IMM
00.0000F1r 0  85 rr        >  STA PTR
00.0000F3r 0  A9 B0        >  LDA #>IMM
00.0000F5r 0  85 rr        >  STA PTR + 1
00.0000F7r 1                   load16 TMP_PTR, START_REGION_COLOR_RAM
00.0000F7r 0  A9 00        >  LDA #<IMM
00.0000F9r 0  85 rr        >  STA PTR
00.0000FBr 0  A9 B0        >  LDA #>IMM
00.0000FDr 0  85 rr        >  STA PTR + 1
00.0000FFr 1               
00.0000FFr 1  20 rr rr         JSR copy_vram_block
00.000102r 1               
00.000102r 1                   ; --------------------------------------------------------------------
00.000102r 1                   ; Step 3: Clear Bottom Row
00.000102r 1                   ; --------------------------------------------------------------------
00.000102r 1  A0 27            LDY #(SCREEN_COLS - 1)
00.000104r 1               @clear_bottom:
00.000104r 1               
00.000104r 1  A9 B5            LDA #DEFAULT_SCREEN_CHAR
00.000106r 1  99 98 A3         STA START_REGION_CHAR_RAM + BOTTOM_ROW_OFFSET, Y
00.000109r 1  A5 rr            LDA CURRENT_COLOR
00.00010Br 1  99 98 B3         STA START_REGION_COLOR_RAM + BOTTOM_ROW_OFFSET, Y
00.00010Er 1  88               DEY
00.00010Fr 1               
00.00010Fr 1  10 F3            BPL @clear_bottom
00.000111r 1               
00.000111r 1                   ; Clamp cursor to bottom row
00.000111r 1  A9 17            LDA #(SCREEN_ROWS - 1)
00.000113r 1  85 rr            STA CURS_ROW
00.000115r 1               
00.000115r 1                   pop_ptr TMP_PTR
00.000115r 0  68           >  PLA
00.000116r 0  85 rr        >  STA P + 1
00.000118r 0  68           >  PLA
00.000119r 0  85 rr        >  STA P
00.00011Br 1                   pop_ptr DISPLAY_PTR
00.00011Br 0  68           >  PLA
00.00011Cr 0  85 rr        >  STA P + 1
00.00011Er 0  68           >  PLA
00.00011Fr 0  85 rr        >  STA P
00.000121r 1                   popall
00.000121r 0  68           >  PLA 
00.000122r 0  A8           >  TAY 
00.000123r 0  68           >  PLA 
00.000124r 0  AA           >  TAX 
00.000125r 0  68           >  PLA 
00.000126r 0  28           >  PLP 
00.000127r 1  60               RTS
00.000128r 1               .endproc
00.000128r 1               
00.000128r 1               ; ----------------------------------------------------------------------------
00.000128r 1               ; Internal Helper: Copies TOTAL_SCROLL_BYTES from DISPLAY_PTR to TMP_PTR
00.000128r 1               ; ----------------------------------------------------------------------------
00.000128r 1               .proc copy_vram_block
00.000128r 1               ; --- Copy Full 256-byte Pages ---
00.000128r 1  A2 03            LDX #PAGES_TO_COPY
00.00012Ar 1  F0 10            BEQ @remaining
00.00012Cr 1               
00.00012Cr 1  A0 00            LDY #$00
00.00012Er 1               @page_loop:
00.00012Er 1  B1 rr            LDA (DISPLAY_PTR), Y
00.000130r 1  91 rr            STA (TMP_PTR), Y
00.000132r 1  C8               INY
00.000133r 1  D0 F9            BNE @page_loop
00.000135r 1               
00.000135r 1  E6 rr            INC DISPLAY_PTR + 1
00.000137r 1  E6 rr            INC TMP_PTR + 1
00.000139r 1  CA               DEX
00.00013Ar 1  D0 F2            BNE @page_loop
00.00013Cr 1               
00.00013Cr 1                   ; Copy remaining
00.00013Cr 1               @remaining:
00.00013Cr 1  A0 00            LDY #$00
00.00013Er 1  C0 98            CPY #REM_BYTES_TO_COPY
00.000140r 1  F0 09            BEQ @done
00.000142r 1               
00.000142r 1               @rem_loop:
00.000142r 1  B1 rr            LDA (DISPLAY_PTR), Y
00.000144r 1  91 rr            STA (TMP_PTR), Y
00.000146r 1  C8               INY
00.000147r 1  C0 98            CPY #REM_BYTES_TO_COPY
00.000149r 1  D0 F7            BNE @rem_loop
00.00014Br 1               
00.00014Br 1               @done:
00.00014Br 1  60               RTS
00.00014Cr 1               .endproc
00.00014Cr 1               
00.00014Cr 1               ; Routine: SET_CURSOR
00.00014Cr 1               ; Description:
00.00014Cr 1               ;   Calculates the Character RAM and Color RAM addresses corresponding
00.00014Cr 1               ;   to the current CURS_COL and CURS_ROW coordinates.
00.00014Cr 1               ;
00.00014Cr 1               ; Outputs:
00.00014Cr 1               ;   CHAR_PTR  - Address in Character RAM
00.00014Cr 1               ;   COLOR_PTR - Corresponding address in Color RAM
00.00014Cr 1               ;
00.00014Cr 1               ; Clobbers:
00.00014Cr 1               ;   A, flags, TMP_PTR, CHAR_PTR, COLOR_PTR
00.00014Cr 1               
00.00014Cr 1               
00.00014Cr 1               
00.00014Cr 1               ;.segment "RODATA"
00.00014Cr 1               row_offsets_low:
00.00014Cr 1                   .byte <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00014Cr 1                   .endrepeat
00.00014Cr 0  00           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00014Dr 0  28           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00014Er 0  50           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00014Fr 0  78           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000150r 0  A0           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000151r 0  C8           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000152r 0  F0           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000153r 0  18           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000154r 0  40           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000155r 0  68           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000156r 0  90           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000157r 0  B8           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000158r 0  E0           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000159r 0  08           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00015Ar 0  30           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00015Br 0  58           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00015Cr 0  80           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00015Dr 0  A8           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00015Er 0  D0           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00015Fr 0  F8           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000160r 0  20           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000161r 0  48           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000162r 0  70           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000163r 0  98           >  .BYTE <(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000164r 1               row_offsets_high:
00.000164r 1                   .byte >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000164r 1                   .endrepeat
00.000164r 0  A0           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000165r 0  A0           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000166r 0  A0           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000167r 0  A0           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000168r 0  A0           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000169r 0  A0           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00016Ar 0  A0           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00016Br 0  A1           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00016Cr 0  A1           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00016Dr 0  A1           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00016Er 0  A1           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00016Fr 0  A1           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000170r 0  A1           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000171r 0  A2           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000172r 0  A2           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000173r 0  A2           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000174r 0  A2           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000175r 0  A2           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000176r 0  A2           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000177r 0  A2           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000178r 0  A3           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.000179r 0  A3           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00017Ar 0  A3           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00017Br 0  A3           >  .BYTE >(START_REGION_CHAR_RAM + (i * SCREEN_COLS))
00.00017Cr 1               
00.00017Cr 1               .segment "CODE"
00.00017Cr 1               .proc SET_CURSOR
00.00017Cr 1  A4 rr            LDY CURS_ROW
00.00017Er 1  B9 rr rr         LDA row_offsets_low, Y
00.000181r 1  85 rr            STA CHAR_PTR
00.000183r 1  B9 rr rr         LDA row_offsets_high, Y
00.000186r 1  85 rr            STA CHAR_PTR+1
00.000188r 1                   ; add column
00.000188r 1  18               CLC
00.000189r 1  A5 rr            LDA CHAR_PTR
00.00018Br 1  65 rr            ADC CURS_COL
00.00018Dr 1  85 rr            STA CHAR_PTR
00.00018Fr 1  90 02            BCC @nocarry
00.000191r 1  E6 rr            INC CHAR_PTR+1
00.000193r 1               @nocarry:
00.000193r 1               
00.000193r 1                   add16i COLOR_PTR, CHAR_PTR, (START_REGION_COLOR_RAM - START_REGION_CHAR_RAM)
00.000193r 0  18           >  CLC
00.000194r 0  A5 rr        >  LDA op1
00.000196r 0  69 00        >  ADC #<(val)
00.000198r 0  85 rr        >  STA dest
00.00019Ar 0  A5 rr        >  LDA op1 + 1
00.00019Cr 0  69 10        >  ADC #>(val)
00.00019Er 0  85 rr        >  STA dest + 1
00.0001A0r 1  60               RTS
00.0001A1r 1               .endproc
