; The formatter has NO idea how to handle this file, so we isolate it out.

; ------------------------------------------------------------
; Three bytes of zero-page scratch space.
; This routine is not reentrant.
; ------------------------------------------------------------

.segment "ZEROPAGE"

delay_count:
    .res 3


; ------------------------------------------------------------
; Shared 24-bit delay routine
;
; Input:
;   delay_count = number of iterations, 1..$FFFFFF
;
; Each iteration costs:
;   35 cycles when BNE is taken
;   34 cycles on the final iteration
;
; Including RTS:
;   35 * count + 5 cycles
;
; Decimal mode must be clear before entry.
; ------------------------------------------------------------

.segment "CODE"

; Keep the backward branch inside one page.
.align 32, $EA

.proc delay_24
loop:
    SEC                         ; 2

    LDA delay_count             ; 3
    SBC #1                      ; 2
    STA delay_count             ; 3

    LDA delay_count+1           ; 3
    SBC #0                      ; 2
    STA delay_count+1           ; 3

    LDA delay_count+2           ; 3
    SBC #0                      ; 2
    STA delay_count+2           ; 3

    ORA delay_count+1           ; 3
    ORA delay_count             ; 3
    BNE loop                    ; 3 taken, 2 final

    RTS                         ; 6
.endproc

; The macro calculates the required CPU cycles without directly 
; multiplying CLOCK_SPEED * milliseconds, which could overflow an 
; assembler limited to 32-bit intermediate values for sufficiently long delays.

; ------------------------------------------------------------
; pause_ms milliseconds
;
; Examples:
;
;     pause_ms 10       ; 10 milliseconds
;     pause_ms 10000    ; 10 seconds
;
; Preserves:
;     A and processor flags
;
; Unchanged:
;     X and Y
;
; Uses:
;     Two stack bytes
;     delay_count through delay_count+2
;
; Timing:
;     Rounded to the nearest CPU cycle
; ------------------------------------------------------------

.macro pause_ms milliseconds
.scope

    ; Calculate:
    ;
    ;     round(CLOCK_SPEED * milliseconds / 1000)
    ;
    ; Splitting CLOCK_SPEED avoids a large intermediate product.

    target_cycles = ((::CLOCK_SPEED / 1000) * (milliseconds)) + ((((::CLOCK_SPEED .mod 1000) * (milliseconds)) + 500) / 1000)

    ; Macro overhead plus delay_24:
    ;
    ;   PHP                 3
    ;   PHA                 3
    ;   CLD                 2
    ;   Three LDA/STA pairs 15
    ;   JSR                 6
    ;   delay_24            35*n + 5
    ;   PLA                 4
    ;   PLP                 4
    ;
    ; Total:
    ;
    ;   35*n + 42 cycles

    iterations .set (target_cycles - 42) / 35
    padding    .set target_cycles - ((iterations * 35) + 42)

    ; There is no one-cycle 6502 instruction. If exactly one
    ; padding cycle remains, remove one loop iteration and turn
    ; the remainder into 36 cycles.

    .if padding = 1
        iterations .set iterations - 1
        padding    .set padding + 35
    .endif

    .assert target_cycles >= 112, error,                                      "pause_ms delay is too short"

    .assert iterations >= 1, error,                                           "pause_ms requires at least one delay iteration"

    .assert iterations <= $FFFFFF, error,                                     "pause_ms delay exceeds the 24-bit counter"

    PHP
    PHA
    CLD

    LDA #<iterations
    STA delay_count

    LDA #>iterations
    STA delay_count+1

    LDA #^iterations
    STA delay_count+2

    JSR delay_24

    ; Generate the remaining 0..36 cycles.
    ;
    ; NOP zp? No: ordinary NOP is 2 cycles.
    ; BIT zp is 3 cycles. The saved flags are restored afterward.

    .if padding .mod 2
        BIT delay_count            ; 3 cycles

        .repeat (padding - 3) / 2
            NOP                    ; 2 cycles
        .endrepeat
    .else
        .repeat padding / 2
            NOP                    ; 2 cycles
        .endrepeat
    .endif

    PLA
    PLP

.endscope
.endmacro

