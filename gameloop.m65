UNSCORED_SLOT = $AEEA


CMD_TOGGLE_DIE = $01
CMD_ROLL_DICE = $02

CMD_NONE = $FF

; This needs to go in the RAM section
STORE_CMD_ACTION .DS 1
STORE_CMD_DATA .DS 1
;

DICE_KEYS_TABLE .BYTE KEY_1, KEY_2, KEY_3, KEY_4, KEY_5
END_DICE_KEYS_TABLE

ATARI_LAST_KEYPRESS = $02FC
ATARI_NO_KEYPRESS = $FF

.PROC PRINTKEY
    PPRINT "KEY PRESSED "
    JSR P_BYTEOUT
    PPRINTLN " "
    RTS
.ENDP

.PROC GET_COMMAND
    LDA #ATARI_NO_KEYPRESS
    STA ATARI_LAST_KEYPRESS
?LOOP
    LDA ATARI_LAST_KEYPRESS
    CMP #ATARI_NO_KEYPRESS
    BEQ ?LOOP

    ; JSR PRINTKEY

    LDA ATARI_LAST_KEYPRESS
    CMP #KEY_R
    BEQ SET_ROLL_DIE_CMD


    ; Get the number of possible dice
    LDY #END_DICE_KEYS_TABLE - DICE_KEYS_TABLE -1

?TRY_DIE
    LDA DICE_KEYS_TABLE,Y
    CMP ATARI_LAST_KEYPRESS
    BEQ PROCESS_DIE_KEY
    DEY
    BPL ?TRY_DIE

?EXIT
    RTS
.ENDP


.PROC PROCESS_DIE_KEY
    STY STORE_CMD_DATA        ; Store the dice # to act upon

    LDA #CMD_TOGGLE_DIE
    STA STORE_CMD_ACTION
    RTS
.ENDP

.PROC RUN_CMD
    LDX STORE_CMD_ACTION

    JMP_IF_X_IS CMD_TOGGLE_DIE HANDLE_TOGGLE_DIE
    JMP_IF_X_IS CMD_ROLL_DICE HANDLE_ROLL_DICE

    RTS
.ENDP

.PROC HANDLE_TOGGLE_DIE
    LDY STORE_CMD_DATA

    LDA #$%10000000
    EOR DICE_VALUES,Y
    STA DICE_VALUES,Y
    JSR SHOW_PIPS

    RTS
.ENDP

.PROC NEW_GAME
    JSR RESET_DIE
    JSR RESET_VALUES
    RTS
.ENDP

.PROC RESET_VALUES
    LDY #GAME_VALUES_COUNT
?LOOP
    LDA # <UNSCORED_SLOT
    STA RAM_VALUE_LSB__TABLE, Y
    LDA # >UNSCORED_SLOT
    STA RAM_VALUE_MSB__TABLE, Y
    DEY
    BPL ?LOOP
    RTS
.ENDP

.PROC RESET_DIE
    LDA #%10000000
    LDY #NUMBER_OF_DICE
?LOOP
    STA DICE_VALUES, Y
    DEY
    BPL ?LOOP

    RTS
.ENDP

.PROC SET_ROLL_DIE_CMD
    LDA #CMD_ROLL_DICE
    STA STORE_CMD_ACTION
    RTS
.ENDP

.PROC HANDLE_ROLL_DICE
    JSR GetRandom
    STA DICE_0_VALUE
    JSR GetRandom
    STA DICE_1_VALUE
    JSR GetRandom
    STA DICE_2_VALUE
    JSR GetRandom
    STA DICE_3_VALUE
    JSR GetRandom
    STA DICE_4_VALUE
.ENDP

.PROC SHOW_VALUE
; How many characters are we actually going to print?
PRINT_LEN = 4

    PUSHALL

    LDA RAM_VALUE_MSB__TABLE, Y
    STA MSIINT + 1
    LDA RAM_VALUE_LSB__TABLE, Y
    STA MSIINT

    JSR INT2STR
    POPALL

    ; Address of the text buffer to print.
    LDA # <MSISTR
    STA SCR_PTR_L
    LDA # >MSISTR
    STA SCR_PTR_H

    ; We are never going to print that first byte, so skip it from the get-go.
    INC16 SCR_PTR_L

    ; Length of the text buffer.
    LDA # <PRINT_LEN
    STA SCR_LEN_L
    LDA # >PRINT_LEN
    STA SCR_LEN_H

    ; Set cursor position
    LDA GAME_VALUES_ROWS, Y
    STA SCR_ROW

    LDA GAME_VALUES_COL_LSB,Y
    STA SCR_COL_L
    LDA GAME_VALUES_COL_MSB,Y
    STA SCR_COL_H

    JMP HW_DISPLAY
.ENDP

V1 = $FF
V2 = $FF

.MACRO QQ
    LDY #%$1
    JSR SHOW_VALUE
.ENDM

.PROC SHOW_ALL_VALUES

    QQ GAME_VALUES_S1C
    QQ GAME_VALUES_S2C
    QQ GAME_VALUES_S3C
    QQ GAME_VALUES_S4C
    QQ GAME_VALUES_S5C
    QQ GAME_VALUES_S6C
    QQ GAME_VALUES_STS
    QQ GAME_VALUES_STB
    QQ GAME_VALUES_SUT ;;
    QQ GAME_VALUES_S3K
    QQ GAME_VALUES_S4K
    QQ GAME_VALUES_SFH
    QQ GAME_VALUES_SSS
    QQ GAME_VALUES_SLS
    QQ GAME_VALUES_S5K ;;
    QQ GAME_VALUES_SCH ;;
    QQ GAME_VALUES_S5B ;;
    QQ GAME_VALUES_SLT ;;
    QQ GAME_VALUES_SGT ;;;;;;;;;;
    QQ GAME_VALUES_RCT

    RTS
.ENDP

GAMELOOP
    LDA #CMD_NONE           ; Erase the last command
    STA STORE_CMD_ACTION    ; Entirely

    JSR SHOW_PIPS
    JSR SHOW_ALL_VALUES


    JSR GET_COMMAND
    JSR RUN_CMD

    PPRINTLN "GAME LOOP"

    JMP GAMELOOP