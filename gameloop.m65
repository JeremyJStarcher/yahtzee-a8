
; This needs to go in the RAM section
DATA_CMD_ACTION .DS 1
DATA_CMD_DATA .DS 1
DATA_STATE .DS 1
DATA_NEXT_STATE .DS 1


; Back to ROM
STATE_JUST_LOADED = 1
STATE_WAITING_FOR_NEW_GAME = 1


UNSCORED_SLOT_VALUE = $AEEA
REROLL_DIE_MASK = %10000000

CMD_TOGGLE_DIE = $01
CMD_ROLL_DICE = $02
CMD_NONE = $FF


DICE_KEYS_TABLE .BYTE KEY_1, KEY_2, KEY_3, KEY_4, KEY_5
END_DICE_KEYS_TABLE

; The address of the last keypress on the keyboard.
ATARI_LAST_KEYPRESS = $02FC
ATARI_NO_KEYPRESS = $FF

.PROC PRINTKEY
    PPRINT "KEY PRESSED "
    JSR P_BYTEOUT
    PPRINTLN " "
    RTS
.ENDP

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Get the command. Process I/O and use the COMMAND pattern
;
; Inputs: none
; Output:
;   DATA_CMD_ACTION
;   DATA_CMD_DATA
;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.PROC GET_COMMAND
;    LDA #ATARI_NO_KEYPRESS

    LDX ATARI_LAST_KEYPRESS
    JMP_IF_X_IS KEY_R SET_ROLL_DIE_CMD

    ; Get the number of possible dice
    LDY #END_DICE_KEYS_TABLE - DICE_KEYS_TABLE -1

?TRY_DIE
    LDA DICE_KEYS_TABLE,Y
    CMP ATARI_LAST_KEYPRESS
    BEQ PROCESS_DIE_KEY
    DEY
    BPL ?TRY_DIE

?EXIT
    RTS
.ENDP

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; One of the dice key was pressed
;
; Inputs:
;   Y - The index of the dice keys lookup table.
;
; Outputs:
;
;  DATA_CMD_ACTION = CMD_TOGGLE_DIE
;  DATA_CMD_DATA = Y
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.PROC PROCESS_DIE_KEY
    STY DATA_CMD_DATA        ; Store the dice # to act upon

    LDA #CMD_TOGGLE_DIE
    STA DATA_CMD_ACTION
    RTS
.ENDP

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Actually execute the command pattern
;
; Inputs:
;  DATA_CMD_ACTION
; Returns:
;  none
; Destroys all registers.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.PROC RUN_CMD
    LDX DATA_CMD_ACTION

    JMP_IF_X_IS CMD_TOGGLE_DIE HANDLE_TOGGLE_DIE
    JMP_IF_X_IS CMD_ROLL_DICE HANDLE_ROLL_DICE

    RTS
.ENDP


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Toggle a die between selectedand not selected.
;
; Input:
;   y - The index of the die to toggle.
;
; Returns: none
;
; Destroys all registers
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.PROC HANDLE_TOGGLE_DIE
    LDY DATA_CMD_DATA

    LDA #REROLL_DIE_MASK
    EOR DICE_VALUES,Y
    STA DICE_VALUES,Y
    JSR SHOW_PIPS

    RTS
.ENDP

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Set the ROLL_DIE command
;
; Inputs: none
; Outputs:
;  DATA_CMD_ACTION
; Destroys
;  A
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.PROC SET_ROLL_DIE_CMD
    LDA #CMD_ROLL_DICE
    STA DATA_CMD_ACTION
    RTS
.ENDP

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Roll the DICE
;
; Inputs: none
; Outputs: none
; Destroys:
;   A
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.PROC HANDLE_ROLL_DICE

    LDY #DIE_LAST_INDEX
?LOOP
    JSR GetRandom
    STA DICE_VALUES, Y
    DEY
    BPL ?LOOP

    RTS
.ENDP


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Prepare the data for a new game
;
; Inputs: none
; Outputs: none
; Destroys registers
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.PROC NEW_GAME
    JSR RESET_DIE
    JSR RESET_VALUES

    SET_GAME_VALUE GAME_VALUES_RCT 1024

    RTS
.ENDP


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Compares a game value to the default score sheet value
; inputs:
;   Y - score index
; Returns:
;   Z = 1 if match
; Destroys A
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.PROC COMPARE_TO_DEFAULT:
    LDA RAM_VALUE_LSB__TABLE,Y
    CMP # <UNSCORED_SLOT_VALUE
    BNE NOT_EQUAL    ; Low byte not $FF -> Z=0, return
    LDA RAM_VALUE_MSB__TABLE,Y
    CMP # >UNSCORED_SLOT_VALUE
    RTS

NOT_EQUAL:
    RTS              ; Z is already 0 from the BNE condition
.ENDP

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Clears all of the scoresheet values
; Inputs: none
; Outputs: none
; Destroys:
;   A, Y
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.PROC RESET_VALUES
    LDY #GAME_VALUES_LAST
?LOOP
    LDA # <UNSCORED_SLOT_VALUE
    STA RAM_VALUE_LSB__TABLE, Y
    LDA # >UNSCORED_SLOT_VALUE
    STA RAM_VALUE_MSB__TABLE, Y
    DEY
    BPL ?LOOP
    RTS
.ENDP

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Resets all of the dice to be re-rolled
; Inputs: none
; Outputs: none
; Destroys:
;   A, Y
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.PROC RESET_DIE
    LDA #REROLL_DIE_MASK
    LDY #DIE_LAST_INDEX
?LOOP
    STA DICE_VALUES, Y
    DEY
    BPL ?LOOP
    RTS
.ENDP

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;  Display a scoresheet value
;
; Inputs:
;   Y - The index to Display
; Returns: none
; Destroys:
;  A
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.PROC DISPLAY_VALUE
; How many characters are we actually going to print?
    PRINT_LEN = 4

    JSR COMPARE_TO_DEFAULT
    BNE ?SKIP
    RTS
?SKIP
    PUSHALL

    LDA RAM_VALUE_MSB__TABLE, Y
    STA MSIINT + 1
    LDA RAM_VALUE_LSB__TABLE, Y
    STA MSIINT

    JSR INT2STR
    POPALL

    ; Address of the text buffer to print.
    LDA # <MSISTR
    STA SCR_PTR_L
    LDA # >MSISTR
    STA SCR_PTR_H

    ; We are never going to print that first byte, so skip it from the get-go.
    INC16 SCR_PTR_L

    ; Length of the text buffer.
    LDA # <PRINT_LEN
    STA SCR_LEN_L
    LDA # >PRINT_LEN
    STA SCR_LEN_H

    ; Set cursor position
    LDA GAME_VALUES_ROWS, Y
    STA SCR_ROW

    LDA GAME_VALUES_COL_LSB,Y
    STA SCR_COL_L
    LDA GAME_VALUES_COL_MSB,Y
    STA SCR_COL_H

    JMP HW_DISPLAY
.ENDP

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;  Display all values
;
; Inputs: none
; Returns: none
; Destroys:
;   A, Y
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.PROC DISPLAY_ALL_VALUES
    LDY #GAME_VALUES_LAST
?LOOP
    JSR DISPLAY_VALUE
    DEY
    BPL ?LOOP
    RTS
.ENDP

    LDY #REPLACEMENT_LABELS_INSTR_START
    JSR DISPLAY_MESSAGE


.PROC GAMELOOP

    JSR SHOW_PIPS
    JSR DISPLAY_ALL_VALUES

    JSR GET_COMMAND
    JSR RUN_CMD
    LDA #CMD_NONE           ; Erase the last command
    CMP DATA_CMD_ACTION

    LDY #ATARI_NO_KEYPRESS
    STY ATARI_LAST_KEYPRESS
    STA DATA_CMD_ACTION    ; Entirely


    JSR GetRandom  ; Keep the randon number generator churning


    JMP GAMELOOP
.ENDP