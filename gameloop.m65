CMD_TOGGLE_DIE = 1
CMD_DATA .DS 0

DICE_KEYS_TABLE .BYTE KEY_1, KEY_2, KEY_3, KEY_4, KEY_5
END_DICE_KEYS_TABLE


ATARI_LAST_KEYPRESS = $02FC
ATARI_NO_KEYPRESS = $FF

GET_COMMAND
    LDA #ATARI_NO_KEYPRESS
    STA ATARI_LAST_KEYPRESS
GET_COMMAND_LOOP
    LDA ATARI_LAST_KEYPRESS
    CMP #ATARI_NO_KEYPRESS
    BEQ GET_COMMAND_LOOP

    LDY #END_DICE_KEYS_TABLE - DICE_KEYS_TABLE -1

GET_CMD_K
    LDA DICE_KEYS_TABLE,Y
    CMP ATARI_LAST_KEYPRESS
    BEQ PROCESS_DIE_KEY
    DEY
    BPL GET_CMD_K

    JMP GET_COMMAND

PROCESS_DIE_KEY
    PPRINT "Read key "
    JSR P_BYTEOUT
    PPRINTLN " "
    JMP GET_COMMAND

GAMELOOP
    ;JSR SHOW_PIPS

    JSR GET_COMMAND

    JMP GAMELOOP