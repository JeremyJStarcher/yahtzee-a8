CMD_TOGGLE_DIE = $01
CMD_ROLL_DICE = $02

CMD_NONE = $FF

; This needs to go in the RAM section
STORE_CMD_ACTION .DS 1
STORE_CMD_DATA .DS 1
;

DICE_KEYS_TABLE .BYTE KEY_1, KEY_2, KEY_3, KEY_4, KEY_5
END_DICE_KEYS_TABLE

ATARI_LAST_KEYPRESS = $02FC
ATARI_NO_KEYPRESS = $FF

.PROC PRINTKEY
    PPRINT "KEY PRESSED "
    JSR P_BYTEOUT
    PPRINTLN " "
    RTS
.ENDP

.PROC GET_COMMAND
    LDA #CMD_NONE           ; Erase the last command
    STA STORE_CMD_ACTION    ; Entirely

    LDA #ATARI_NO_KEYPRESS
    STA ATARI_LAST_KEYPRESS
?LOOP
    LDA ATARI_LAST_KEYPRESS
    CMP #ATARI_NO_KEYPRESS
    BEQ ?LOOP

    JSR PRINTKEY

    LDA ATARI_LAST_KEYPRESS
    CMP #KEY_R
    BEQ ROLL_DIE


    ; Get the number of possible dice
    LDY #END_DICE_KEYS_TABLE - DICE_KEYS_TABLE -1

?TRY_DIE
    LDA DICE_KEYS_TABLE,Y
    CMP ATARI_LAST_KEYPRESS
    BEQ PROCESS_DIE_KEY
    DEY
    BPL ?TRY_DIE

?EXIT
    RTS
.ENDP


.PROC PROCESS_DIE_KEY
    STY STORE_CMD_DATA        ; Store the dice # to act upon

    LDA #CMD_TOGGLE_DIE
    STA STORE_CMD_ACTION
    RTS
.ENDP

; TODO: Replace this with a lookup table, or at very least, counting down 'X' and comparing.
.PROC RUN_CMD
    CMP #CMD_TOGGLE_DIE
    BNE ?J2
    JMP HANDLE_TOGGLE_DIE

?J2
    RTS
.ENDP

.PROC HANDLE_TOGGLE_DIE
    LDY STORE_CMD_DATA

    LDA #$~10000000
    EOR DICE_VALUES,Y
    STA DICE_VALUES,Y
    JSR SHOW_PIPS

    RTS
.ENDP

.PROC RESET_DIE
        LDA #%10000000
        STA DICE_0_VALUE
        STA DICE_1_VALUE
        STA DICE_2_VALUE
        STA DICE_3_VALUE
        STA DICE_4_VALUE

        JMP SHOW_PIPS
.ENDP

.PROC ROLL_DIE
        JSR GetRandom
        STA DICE_0_VALUE
        JSR GetRandom
        STA DICE_1_VALUE
        JSR GetRandom
        STA DICE_2_VALUE
        JSR GetRandom
        STA DICE_3_VALUE
        JSR GetRandom
        STA DICE_4_VALUE

        JMP SHOW_PIPS
.ENDP


GAMELOOP
    ;JSR SHOW_PIPS

    JSR GET_COMMAND
    JSR RUN_CMD

    PPRINTLN "GAME LOOP"

    JMP GAMELOOP