CMD_TOGGLE_DIE = $01
CMD_ROLL_DICE = $02

CMD_NONE = $FF

; This needs to go in the RAM section
STORE_CMD_ACTION .DS 1
STORE_CMD_DATA .DS 1
;

DICE_KEYS_TABLE .BYTE KEY_1, KEY_2, KEY_3, KEY_4, KEY_5
END_DICE_KEYS_TABLE

ATARI_LAST_KEYPRESS = $02FC
ATARI_NO_KEYPRESS = $FF

.PROC PRINTKEY
    PPRINT "KEY PRESSED "
    JSR P_BYTEOUT
    PPRINTLN " "
    RTS
.ENDP

.PROC GET_COMMAND
    LDA #ATARI_NO_KEYPRESS
    STA ATARI_LAST_KEYPRESS
?LOOP
    LDA ATARI_LAST_KEYPRESS
    CMP #ATARI_NO_KEYPRESS
    BEQ ?LOOP

    ; JSR PRINTKEY

    LDA ATARI_LAST_KEYPRESS
    CMP #KEY_R
    BEQ SET_ROLL_DIE_CMD


    ; Get the number of possible dice
    LDY #END_DICE_KEYS_TABLE - DICE_KEYS_TABLE -1

?TRY_DIE
    LDA DICE_KEYS_TABLE,Y
    CMP ATARI_LAST_KEYPRESS
    BEQ PROCESS_DIE_KEY
    DEY
    BPL ?TRY_DIE

?EXIT
    RTS
.ENDP


.PROC PROCESS_DIE_KEY
    STY STORE_CMD_DATA        ; Store the dice # to act upon

    LDA #CMD_TOGGLE_DIE
    STA STORE_CMD_ACTION
    RTS
.ENDP

.PROC RUN_CMD
    LDX STORE_CMD_ACTION

    JMP_IF_X_IS CMD_TOGGLE_DIE HANDLE_TOGGLE_DIE
    JMP_IF_X_IS CMD_ROLL_DICE HANDLE_ROLL_DICE

    RTS
.ENDP

.PROC HANDLE_TOGGLE_DIE
    LDY STORE_CMD_DATA

    LDA #$~10000000
    EOR DICE_VALUES,Y
    STA DICE_VALUES,Y
    JSR SHOW_PIPS

    RTS
.ENDP

.PROC RESET_DIE
    LDA #%10000000
    STA DICE_0_VALUE
    STA DICE_1_VALUE
    STA DICE_2_VALUE
    STA DICE_3_VALUE
    STA DICE_4_VALUE

    JMP SHOW_PIPS
.ENDP

.PROC SET_ROLL_DIE_CMD
    LDA #CMD_ROLL_DICE
    STA STORE_CMD_ACTION
    RTS
.ENDP

.PROC HANDLE_ROLL_DICE
    JSR GetRandom
    STA DICE_0_VALUE
    JSR GetRandom
    STA DICE_1_VALUE
    JSR GetRandom
    STA DICE_2_VALUE
    JSR GetRandom
    STA DICE_3_VALUE
    JSR GetRandom
    STA DICE_4_VALUE

    JMP SHOW_PIPS
.ENDP

.PROC SHOW_VALUE

    PUSHALL
    LDA RAM_VALUE_LSB__TABLE, Y
    STA MSIINT
    LDA RAM_VALUE_MSB__TABLE, Y
    STA MSIINT + 1


    JSR INT2STR
    POPALL

    ; Address of the text buffer to print.
    LDA # <MSISTR
    STA SCR_PTR_L
    LDA # >MSISTR
    STA SCR_PTR_H

    ; Length of the text buffer.
    LDA # <5
    STA SCR_LEN_L
    LDA # >5
    STA SCR_LEN_H

    ; Set cursor position
    LDA TITLE_ROW_TABLE, Y
    STA SCR_ROW

    LDA TITLE_COL_LSB_TABLE,Y
    STA SCR_COL_L
    LDA TITLE_COL_MSB_TABLE,Y
    STA SCR_COL_H

    JMP HW_DISPLAY
.ENDP


GAMELOOP
    LDA #CMD_NONE           ; Erase the last command
    STA STORE_CMD_ACTION    ; Entirely

VALUE = 1234
    LDY #GAME_VALUES_S1C
        LDA #<VALUE
        STA RAM_VALUE_LSB__TABLE, Y
        LDA #>VALUE
        STA RAM_VALUE_MSB__TABLE, Y



    LDY #GAME_VALUES_S1C
    JSR SHOW_VALUE
    LDY #GAME_VALUES_S1C +1
    JSR SHOW_VALUE
    LDY #GAME_VALUES_S1C +1
    JSR SHOW_VALUE

    JSR GET_COMMAND
    JSR RUN_CMD

    PPRINTLN "GAME LOOP"

    JMP GAMELOOP