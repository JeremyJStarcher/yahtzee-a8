; ================================================================
; Atari 800XL / Atari 8-bit
; 6502 Assembly Springboard Program
;
; Purpose:
;   Open the screen editor device "E:"
;   Print one line of text
;   Stop in an infinite loop
;
; Auto-run:
;   This source includes a RUNAD segment at $02E0/$02E1.
;   When loaded as an Atari DOS binary/XEX file, DOS will jump
;   to START after the file finishes loading.
;
; Boot-time auto-run:
;   Save/name the final binary as AUTORUN.SYS on a DOS disk.
;
; ================================================================


HIGHEST_DICE_FACE = 6
NUMBER_OF_DICE = 5
DIE_LAST_INDEX = NUMBER_OF_DICE-1
NUMBER_OF_PIPS = 7

; ------------------------------------------------
; Main program load address
; ------------------------------------------------
    *=$00CB
STRPTR          .WORD 0
ENDPTR          .WORD 0
SAVEA           .BYTE 0  ; Save 'A' during PUSHALL
; A pointer to which set of pips we are rendering
PIP_PTR         .DS 2
PIP_MASK        .DS 1

; Free 0-page address (USED BY BASIC)
; $CB - $D1


.INCLUDE sysequ.m65
.INCLUDE iomac.lib
.INCLUDE macros.inc

; The current die being operated on.
CURRENT_DIE             .DS 1
CURRENT_PIP_ON_SCREEN   .DS 1
CURRENT_PIP_ON_DIE      .DS 1
CURRENT_PIP_PATTERN     .BYTE 1

    MAKE_OUTPUT_CONTROL SCR E_IOCB2
    MAKE_OUTPUT_CONTROL DBG P_IOCB3

    *=$2000

.INCLUDE hardware/a8/atari_keys.m65
.INCLUDE hardware/a8/io.m65
.INCLUDE resource-builder/strings.m65
.INCLUDE state.m65
.INCLUDE gameloop.m65

; ================================================================
; PROGRAM ENTRY POINT
; ================================================================

START:
    JSR INIT_PROGRAM

    JSR ShowMainBody
    JSR ShowDiceLabels
    LDA #STATE_JUST_LOADED
    STA DATA_STATE
    LDA #STATE_WAITING_FOR_NEW_GAME
    STA DATA_NEXT_STATE

    JSR EMPTY_VALUES

    JSR GAMELOOP

    JMP FINISH_PROGRAM

;;;;;;;;;;;;;;;;;;;;;;;
; Display the main body
;
; Input: none
; Returns: none
; Destroys registers
;;;;;;;;;;;;;;;;;;;;;;;

.PROC ShowMainBody
    LDY #FRAME_START
    JSR DISPLAY_MESSAGE
    SHOW_RANGE LABELS_START LABELS_LAST
    RTS
.ENDP

;;;;;;;;;;;;;;;;;;;;;;;
; Display the various screen labels
;
; Input: none
; Returns: none
; Destroys registers
;;;;;;;;;;;;;;;;;;;;;;;
.PROC ShowDiceLabels
    SHOW_RANGE2 DICE_START DICE_LAST
    RTS
.ENDP


;;;;;;;;;;;;;;;;;;;;;;;
; Display the various screen labels
; Takes positioning and text data from the precomputed
; tables.
; Input:
;   Y = The index of the message to print
; Returns: none
; Preservers all registers.
;;;;;;;;;;;;;;;;;;;;;;;

.PROC DISPLAY_MESSAGE
    PUSHALL        ; Save all registers

    ; Address of the text buffer to print.
    LDA TITLE_TXT_LSB_TABLE,Y
    STA SCR_PTR_L
    LDA TITLE_TXT_MSB_TABLE,Y
    STA SCR_PTR_H

    ; Length of the text buffer.
    LDA TITLE_LEN_LSB_TABLE,Y
    STA SCR_LEN_L
    LDA TITLE_LEN_MSB_TABLE,Y
    STA SCR_LEN_H

    ; Set cursor position
    LDA TITLE_ROW_TABLE,Y
    STA SCR_ROW

    LDA TITLE_COL_LSB_TABLE, Y
    STA SCR_COL_L
    LDA TITLE_COL_MSB_TABLE, Y
    STA SCR_COL_H

    JSR HW_DISPLAY

    POPALL         ; Restore all registers
    RTS
.ENDP



; "┌───┐",
; "|0 1|",
; "|234|",
; "|5 6|",
; "└───┘",

;; This is the binary pattern for each die face and the pips that would be activated.
PIP_PATTERNS
    .BYTE %00000000
    .BYTE %00010000
    .BYTE %01000100
    .BYTE %01010100
    .BYTE %11000110
    .BYTE %11010110
    .BYTE %11101110

; Quick lookup table to match a pip number to the pattern above.
; A multi-bitshift lookup table rather than looping.
SHFTPIP
    .BYTE %00000001
    .BYTE %00000010
    .BYTE %00000100
    .BYTE %00001000
    .BYTE %00010000
    .BYTE %00100000
    .BYTE %01000000
    .BYTE %10000000


;;;;;;;;;;;;;;;;;;;;;;;;;
;; Show all of the pips
;;
;; Inputs: none
;; Returns: none
;; Destroys all registers
;;
;; We loop through all of the pips in our pips data.
;; This contains the position values for ALL pips on
;; ALL dice.
;;
;; Every time we count down one dice worth of pips,
;; we increment which die we are looking at.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.PROC SHOW_PIPS
    ;; Set things up for the first pip on the first die

    LDY #$00
    STY CURRENT_DIE
    LDA PIP_PATTERNS,Y
    STA CURRENT_PIP_PATTERN

    LDA PIP_PTR_LSB,Y
    STA PIP_PTR
    LDA PIP_PTR_MSB,Y
    STA PIP_PTR +1

    LDA #$00
    STA CURRENT_PIP_ON_SCREEN

    LDX #NUMBER_OF_DICE
?NEXT_DIE
    LDY #NUMBER_OF_PIPS
?NEXT_PIP
    STY CURRENT_PIP_ON_DIE
    JSR SHOWPIP
    DEY
    BNE ?NEXT_PIP
    INC CURRENT_DIE
    DEX
    BNE ?NEXT_DIE
    RTS
.ENDP

;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Used internally by SHOW_PIPS. Should never be called alone
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.PROC SHOWPIP
    PUSHALL        ; Save all registers

    PREP_DISPLAY

    LDA #<SCRBUF
    STA SCR_PTR_L
    LDA #>SCRBUF
    STA SCR_PTR_H

    LDA #$01
    STA SCR_LEN_L
    LDA #$00
    STA SCR_LEN_H

    LDY CURRENT_PIP_ON_SCREEN

    LDA (PIP_PTR),Y
    STA SCR_ROW

    ; Next byte
    INY
    LDA (PIP_PTR),Y
    STA SCR_COL_L
    INY
    LDA (PIP_PTR),Y
    STA SCR_COL_H
    INY
    STY CURRENT_PIP_ON_SCREEN

    ; Get the pattern for the current dice value
    LDX CURRENT_DIE
    LDA DICE_VALUES,X
    ; High bit is used to tell when a dice is ready to be re-rolled, so strip that out for for lookup reasons
    AND #%01111111                          ; Strip out the high bit from the calculations
    TAX
    LDA PIP_PATTERNS,X
    STA PIP_MASK

    ; No doubt this can be combined with above

    LDX CURRENT_DIE
    LDA DICE_VALUES,X
    AND #%10000000                          ; Check to see if that high bit is set.
    BNE ?HIDEPIP                           ; Dice is selected

    ; Get the pattern for the current dice value
    LDY CURRENT_PIP_ON_DIE
    LDA SHFTPIP,Y
    BIT PIP_MASK
    BNE ?PIP_SHOW_FILLED

    LDY #32
    JMP ?PIPSHOW_DISPLAY

?PIP_SHOW_FILLED
    LDY #'*

?PIPSHOW_DISPLAY
    STY SCRBUF+0
    JSR HW_DISPLAY

    POPALL         ; Restore all registers
    RTS

?HIDEPIP
    LDY #'-
    JMP ?PIPSHOW_DISPLAY
.ENDP

;; These functions were written as debugging tools, not regular
;; library calls, hence they are somewhat paranoid about preserving
;; registers.  This lets us just drop them anywhere and not have worry
;; about program logic changing.


; Print the current byte in HEX format
; Inputs
;   A - The byte to print
; Returns: none
; Preserves all registers.
.PROC P_BYTEOUT
    PHA        ; Save the byte to retrieve at the end
    PHA        ; save the byte
    LSR A      ; Shift the high nibble to the low nibble
    LSR A      ;
    LSR A      ;
    LSR A      ;
    JSR P_NIBBLE_OUT ;
    PLA        ; Restore the saved byte
    AND #$0F   ; Now get the lower nibble
    JSR P_NIBBLE_OUT ; And print
    PLA        ; retrieve the byte
    RTS
.ENDP

; ****************************************************************
; This is the 8-bit random number generator subroutine that uses
; the Galois linear feedback shift register (LFSR) approach.
; This generates and returns a number between 0-255.
; Have two of these to avoid dependencies between powerups and
; mutations.
; Inputs: none
; Returns:
; A - the new random number between 1 and HIGHEST-DICE-face
;   To return something else, that bitmask would also need fixed.
; Preserves registers
; ****************************************************************

; Todo -- move these into RAM
RandomPU        .BYTE 95
RandomMut       .BYTE 74
RandomFlip      .BYTE 0

GetRandom
    INC RandomFlip
    LDA RandomFlip
    LSR
    BCS ?GenRandom1

    JSR ?GetRandomPU
    JMP ?GenRandom2

?GenRandom1
    JSR ?GetRandomMut
?GenRandom2
    AND #%00000111
    CMP #HIGHEST_DICE_FACE+1
    BCS GetRandom

    CMP #$00
    BEQ GetRandom
    RTS

?GetRandomPU             ; this is for powerups
    lda RandomPU    ; load the accumulator with a seed
    lsr             ; logical shift right
    bcc ?SkipEor1    ; branch on carry clear
    eor #$D4        ; exclusive OR (i.e. XOR) function

?SkipEor1

   	sta RandomPU      ; store the random number in variable
   	rts               ; return from subroutine

?GetRandomMut              ; this is for mutation flag

   	lda RandomMut   ; load the accumulator with a seed
    lsr             ; logical shift right
    bcc ?SkipEor2      ; branch on carry clear
    eor #$A9          ; exclusive OR (i.e. XOR) function
     ; $A9 generates inverse sequence

?SkipEor2
   	sta RandomMut     ; store the random number in variable
   	rts               ; return from subroutine

; ----------------------------------------------------------------------
; Func: INT2STR
; Desc: Converts a 16-bit unsigned integer (0–65535) into a fixed-width
;       5-digit decimal string, right-padded with leading zeros, followed
;       by an EOL (End-Of-Line) terminator.
;
; Input:  The 16-bit value is stored at memory location MSIINT (little‑endian).
; Output: The resulting ASCII string is written to MSISTR (6 bytes:
;         5 digits + EOL).
;
; Clobbers: A, X, Y, MSIINT (overwritten with remainder), MSICTR.
; ----------------------------------------------------------------------

.PROC INT2STR

    ; -------- Initialization --------
    LDY #0              ; Y will be the index into the divisor table (ITSTABLE)
    STY MSICTR          ; MSICTR = 0  → output string index

ITSNEXT:
    LDX #0              ; X = digit counter for current power‑of‑10 (resets each divisor)

    ; -------- Division loop: subtract the current divisor repeatedly --------
ITSSLP:
    LDA MSIINT          ; low byte of remainder
    SEC                 ; set borrow for subtraction
    SBC ITSTABLE,Y      ; subtract low byte of current divisor
    STA MSIINT          ; store low byte temporarily

    LDA MSIINT+1        ; high byte of remainder
    INY                 ; Y now points to high byte of the divisor
    SBC ITSTABLE,Y      ; subtract high byte with borrow

    BCC ITSADD          ; if borrow occurred → divisor too large, undo last subtraction

    ; ---- Subtraction succeeded (we can subtract one more time) ----
    STA MSIINT+1        ; store high byte of new remainder
    INX                 ; increment digit count (how many times this divisor fits)
    DEY                 ; Y back to low byte of the same divisor
    CLC                 ; clear carry (so the next SBC works correctly)
    BCC ITSSLP          ; unconditional branch (CLC ensures carry=0 → branch taken)
                        ; try subtracting again with the same divisor

    ; ---- Subtraction failed (borrow set) → revert the last subtraction ----
ITSADD:
    DEY                 ; Y is currently at high‑byte index → decrement to low byte
    LDA MSIINT          ; reload low byte of remainder (which was overwritten)
    ADC ITSTABLE,Y      ; add back the low byte of divisor (carry is set from BCC)
    STA MSIINT          ; restore low byte

    TXA                 ; get digit count (0–9)
    ORA #'0             ; convert to ASCII ('0' .. '9')
    ORA #$80            ; convert to ASCII
    LDX MSICTR          ; load current output position
    STA MSISTR,X        ; store digit in output buffer
    INC MSICTR          ; advance output position

    ; ---- Move to the next divisor (1000, 100, 10) ----
    INY                 ; Y was low byte → increment to high byte
    INY                 ; increment again → low byte of next divisor
    CPY #ITSTABLE_LEN   ; table has 4 entries × 2 bytes = 8 bytes total
    BCC ITSNEXT         ; if Y < 8, process next divisor

    ; -------- Handle the last digit (units: 0–9) --------
    LDA MSIINT          ; remainder is now 0..9 (low byte; high byte is 0)
    ORA #'0'            ; convert to ASCII
    ORA #$80            ; convert to ASCII

    LDX MSICTR          ; current output position
    STA MSISTR,X        ; store units digit

    INX                 ; move past the last digit
    LDA #EOL            ; load end‑of‑line terminator (e.g. 0 or newline)
    STA MSISTR,X        ; terminate the string

    RTS                 ; return to caller

; -------- Lookup table: powers of 10 (16‑bit, little‑endian) --------
ITSTABLE:
    .WORD 10000
    .WORD 1000
    .WORD 100
    .WORD 10
ITSTABLE_LEN = * - ITSTABLE

.ENDP


;        *=$4000

; -------- Data allocations (storage for the routine) --------


.INCLUDE resource-builder/ram.m65

MSISTR   *= *+6         ; reserve 6 bytes for the output string (5 digits + EOL)
MSIINT   *= *+2         ; reserve 2 bytes for the input integer (little‑endian)
MSICTR   *= *+1         ; reserve 1 byte for the output string index


SCRBUF          .DS 50
PRNBUF          .DS 50



; This needs to go in the RAM section
DATA_CMD_ACTION .DS 1
DATA_CMD_DATA .DS 1
DATA_STATE .DS 1
DATA_NEXT_STATE .DS 1
DATA_NEXT_STATE_PARAMS .DS 1

LAST_KEY .DS 1


; ================================================================
; AUTO-RUN SEGMENT
; ================================================================
;
; Atari DOS binary loaders use locations $02E0/$02E1 as RUNAD.
;
; RUNAD contains the address to execute after the whole binary
; file has finished loading.
;
; By placing START here, the DOS binary loader will run START
; automatically after load.
;
; Many Atari-aware assemblers will output this as a second
; binary segment in the same .OBJ/.XEX file.
;
; If your assembler only creates a raw flat binary, see notes below.
; ================================================================

    *=$02E0

    .WORD START
