
.PROC ENTER_TOGGLE_DIE
    LDX DATA_NEXT_STATE_PARAMS

    LDA #REROLL_DIE_MASK
    EOR DICE_VALUES, X
    STA DICE_VALUES, X

    LDA #STATE_REDRAW_DICE
    STA DATA_NEXT_STATE

    RTS
.ENDP

.PROC ENTER_RE_ROLL_DICE
    LDY #DIE_LAST_INDEX
?LOOP
    LDA DICE_VALUES, Y
    AND #REROLL_DIE_MASK
    BEQ ?NOUPDATE
    JSR GetRandom
    STA DICE_VALUES, Y
?NOUPDATE:
    DEY
    BPL ?LOOP
.ENDP

.PROC ENTER_REDRAW_DICE
    JSR SHOW_PIPS
    LDA #STATE_IN_GAME
    STA DATA_NEXT_STATE
    RTS
.ENDP

.PROC ENTER_WAITING_FOR_NEW_GAME
    LDY #REPLACEMENT_LABELS_INSTR_START
    JSR DISPLAY_MESSAGE
    RTS
.ENDP

.PROC ENTER_STARTING_GAME
    JSR RESET_DIE
    JSR RESET_VALUES
    SET_GAME_VALUE GAME_VALUES_RCT 1024
    LDY #REPLACEMENT_LABELS_INSTR_OR_SCORE
    JSR DISPLAY_MESSAGE
    JSR HANDLE_ROLL_DICE
    JSR SHOW_PIPS
    JSR DISPLAY_ALL_VALUES

    LDA #STATE_IN_GAME
    STA DATA_NEXT_STATE

    RTS
.ENDP

.PROC CHANGE_STATE
    LDX DATA_NEXT_STATE
    JMP_IF_X_IS STATE_NONE CHANGE_STATE_NO
    STX DATA_STATE
    LDY #STATE_NONE
    STY DATA_NEXT_STATE

    ;PPRINT "CHANGE STATE "
    ;LDA DATA_STATE
    ;JSR P_BYTEOUT
    ;PPRINTLN " "


    ; Look up the correct jump location
    ; And sure, we'll reuse a pointer.
    LDA STATE_LSB_TABLE,X
    STA MSIINT
    LDA STATE_MSB_TABLE,X
    STA MSIINT +1

    JMP (MSIINT)

CHANGE_STATE_NO:
    RTS
.ENDP

.PROC SET_STATE_IN_GAME
    LDY #STATE_IN_GAME
    STY DATA_NEXT_STATE
    RTS
.ENDP

