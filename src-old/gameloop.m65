UNSCORED_SLOT_VALUE = $AEEA
REROLL_DIE_MASK = %10000000

DICE_KEYS_TABLE .BYTE KEY_1, KEY_2, KEY_3, KEY_4, KEY_5
END_DICE_KEYS_TABLE

NAV_KEYS_TABLE
    .BYTE KEY_Minus ; UP
    .BYTE KEY_Equal ; DOWN
    .BYTE KEY_plus ; LEFT
    .BYTE KEY_Aster ; RIGHT
END_NAV_KEYS_TABLE


; The address of the last keypress on the keyboard.
Z_ATARI_LAST_KEYPRESS = $02FC
ATARI_NO_KEYPRESS = $FF

.PROC PRINTKEY
    PPRINT "KEY PRESSED "
    JSR P_BYTEOUT
    PPRINTLN " "
    RTS
.ENDP

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Get the command. Process I/O and use the COMMAND pattern
;
; Inputs: none
; Output:
;   DATA_CMD_ACTION
;   DATA_CMD_DATA
;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.PROC GET_ATARI_KEY
    LDY Z_ATARI_LAST_KEYPRESS
    STY LAST_KEY
    LDY ATARI_NO_KEYPRESS
    STY Z_ATARI_LAST_KEYPRESS
    RTS
.ENDP

.PROC GET_COMMAND
    JSR GET_ATARI_KEY

    LDX DATA_STATE
    LDY LAST_KEY

    ;JMP_IF_Y_IS ATARI_NO_KEYPRESS EXIT?

    JMP_IF_X_IS STATE_WAITING_FOR_NEW_GAME CMDS_FOR_STATE_WAITING
    JMP_IF_X_IS STATE_IN_GAME CMDS_FOR_IN_GAME
EXIT?
    RTS
.ENDP

.PROC CMDS_FOR_STATE_WAITING
    CPY #KEY_N
    IF_EQ_SET_NEXT_STATE STATE_STARTING_GAME
    RTS
.ENDP


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Look for any commands associated with the IN-GAME state
;;
;; Inputs
;;   LAST_KEY - The last key PRESSED
;; Outputs:
;;   DATA_NEXT_STATE as relevant
;;
;; Destroys
;;    A, X
;; Preserves Y
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.PROC CMDS_FOR_IN_GAME
    LDY LAST_KEY
    CPY #KEY_R
    IF_EQ_SET_NEXT_STATE STATE_RE_ROLL_DICE

    ; Now we check to see if one of the dice-select keys are hit.

    LDX #END_DICE_KEYS_TABLE - DICE_KEYS_TABLE
?LOOP:
    LDA DICE_KEYS_TABLE, X
    CMP LAST_KEY
    BEQ KEYMATCH?
    DEX
    BPL ?LOOP

    RTS

KEYMATCH?:
    LDA #STATE_TOGGLE_DIE
    STA DATA_NEXT_STATE
    STX DATA_NEXT_STATE_PARAMS

    RTS

.ENDP

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Toggle a die between selected and not selected.
;
; Input:
;   y - The index of the die to toggle.
;
; Returns: none
;
; Destroys all registers
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.PROC HANDLE_TOGGLE_DIE
    LDY DATA_CMD_DATA

    LDA #REROLL_DIE_MASK
    EOR DICE_VALUES,Y
    STA DICE_VALUES,Y
    JSR SHOW_PIPS

    RTS
.ENDP


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Roll the DICE
;
; Inputs: none
; Outputs: none
; Destroys:
;   A
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.PROC HANDLE_ROLL_DICE

    LDY #DIE_LAST_INDEX
?LOOP
    JSR GetRandom
    STA DICE_VALUES, Y
    DEY
    BPL ?LOOP

    RTS
.ENDP

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Empty values
; This just creates the empty score sheet
; for the screen to display beforea new game is SET_CMD_ROLL_DIE
;
; Inputs: none
; Outputs: none
; Destroys registers
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.PROC EMPTY_VALUES
    JSR RESET_DIE
    JSR RESET_VALUES
    SET_GAME_VALUE GAME_VALUES_RCT 1024
    LDY #LABELS_INSTR
    JSR DISPLAY_MESSAGE
    RTS
.ENDP


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Compares a game value to the default score sheet value
; inputs:
;   Y - score index
; Returns:
;   Z = 1 if match
; Destroys A
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.PROC COMPARE_TO_DEFAULT:
    LDA RAM_VALUE_LSB__TABLE,Y
    CMP # <UNSCORED_SLOT_VALUE
    BNE NOT_EQUAL    ; Low byte not $FF -> Z=0, return
    LDA RAM_VALUE_MSB__TABLE,Y
    CMP # >UNSCORED_SLOT_VALUE
    RTS

NOT_EQUAL:
    RTS              ; Z is already 0 from the BNE condition
.ENDP

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Clears all of the scoresheet values
; Inputs: none
; Outputs: none
; Destroys:
;   A, Y
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.PROC RESET_VALUES
    LDY #GAME_VALUES_LAST
?LOOP
    LDA # <UNSCORED_SLOT_VALUE
    STA RAM_VALUE_LSB__TABLE, Y
    LDA # >UNSCORED_SLOT_VALUE
    STA RAM_VALUE_MSB__TABLE, Y
    DEY
    BPL ?LOOP
    RTS
.ENDP

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Resets all of the dice to be re-rolled
; Inputs: none
; Outputs: none
; Destroys:
;   A, Y
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.PROC RESET_DIE
    LDA #REROLL_DIE_MASK
    LDY #DIE_LAST_INDEX
?LOOP
    STA DICE_VALUES, Y
    DEY
    BPL ?LOOP
    RTS
.ENDP

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;  Display a scoresheet value
;
; Inputs:
;   Y - The index to Display
; Returns: none
; Destroys:
;  A
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.PROC DISPLAY_VALUE
; How many characters are we actually going to print?
    PRINT_LEN = 4

    JSR COMPARE_TO_DEFAULT
    BNE ?SKIP
    RTS
?SKIP
    PUSHALL

    LDA RAM_VALUE_MSB__TABLE, Y
    STA MSIINT + 1
    LDA RAM_VALUE_LSB__TABLE, Y
    STA MSIINT

    JSR INT2STR
    POPALL

    ; Address of the text buffer to print.
    LDA # <MSISTR
    STA SCR_PTR_L
    LDA # >MSISTR
    STA SCR_PTR_H

    ; We are never going to print that first byte, so skip it from the get-go.
    INC16 SCR_PTR_L

    ; Length of the text buffer.
    LDA # <PRINT_LEN
    STA SCR_LEN_L
    LDA # >PRINT_LEN
    STA SCR_LEN_H

    ; Set cursor position
    LDA GAME_VALUES_ROWS, Y
    STA SCR_ROW

    LDA GAME_VALUES_COL_LSB,Y
    STA SCR_COL_L
    LDA GAME_VALUES_COL_MSB,Y
    STA SCR_COL_H

    JMP HW_DISPLAY
.ENDP

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;  Display all values
;
; Inputs: none
; Returns: none
; Destroys:
;   A, Y
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.PROC DISPLAY_ALL_VALUES
    LDY #GAME_VALUES_LAST
?LOOP
    JSR DISPLAY_VALUE
    DEY
    BPL ?LOOP
    RTS
.ENDP

.PROC DUMP_STATE
    PPRINT "CHANGE_STATE START (CS) "
    LDA DATA_STATE
    JSR P_BYTEOUT
    PPRINT " (NS)"
    LDA DATA_NEXT_STATE
    JSR P_BYTEOUT
    PPRINTLN " "
    RTS
.ENDP


.PROC GAMELOOP
    ;JSR DUMP_STATE
    JSR CHANGE_STATE
    ; JSR SHOW_PIPS

    JSR GET_COMMAND

    ;LDY #ATARI_NO_KEYPRESS
    ;STY ATARI_LAST_KEYPRESS

    JSR GetRandom  ; Keep the randon number generator churning

    JMP GAMELOOP
.ENDP