; REGION_STATES
STATE_NONE = 0
STATE_JUST_LOADED = 1
STATE_WAITING_FOR_NEW_GAME = 2
STATE_IN_GAME = 3
STATE_RE_ROLL_DICE = 4
STATE_STARTING_GAME = 5
STATE_REDRAW_DICE = 6
STATE_TOGGLE_DIE = 7
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
STATE_LSB_TABLE
    .BYTE <CHANGE_STATE_NO
    .BYTE <CHANGE_STATE_NO
    .BYTE <ENTER_WAITING_FOR_NEW_GAME
    .BYTE <CHANGE_STATE_NO
    .BYTE <ENTER_RE_ROLL_DICE
    .BYTE <ENTER_STARTING_GAME
    .BYTE <ENTER_REDRAW_DICE
    .BYTE <ENTER_TOGGLE_DIE
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
STATE_MSB_TABLE
    .BYTE >CHANGE_STATE_NO
    .BYTE >CHANGE_STATE_NO
    .BYTE >ENTER_WAITING_FOR_NEW_GAME
    .BYTE >CHANGE_STATE_NO
    .BYTE >ENTER_RE_ROLL_DICE
    .BYTE >ENTER_STARTING_GAME
    .BYTE >ENTER_REDRAW_DICE
    .BYTE >ENTER_TOGGLE_DIE